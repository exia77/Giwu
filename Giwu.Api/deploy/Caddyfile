# Replace api.giwu-hrms.com with your real domain.
# Caddy auto-fetches a Let's Encrypt cert when DNS resolves.
api.giwu-hrms.com {
    reverse_proxy api:8080
    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }
    log {
        output stdout
        format console
    }
}
