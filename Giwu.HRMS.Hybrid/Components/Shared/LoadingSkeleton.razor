@*  Skeleton loader — feels noticeably faster than a spinner because the
    user sees structural placeholders for the content that's about to
    appear, instead of an indeterminate progress UI.

    Usage:
        <LoadingSkeleton Rows="3" />              <!-- 3 list rows -->
        <LoadingSkeleton Variant="LoadingSkeleton.Shape.Card" />
        <LoadingSkeleton Variant="LoadingSkeleton.Shape.Stat" Count="4" />

    The page swaps spinner-in-condition for this:
        @if (_loading) { <LoadingSkeleton Variant=... /> }
        else { ... real content ... }                                       *@

@switch (Variant)
{
    case Shape.Stat:
        <div class="giwu-skel-grid">
            @for (int i = 0; i < Count; i++)
            {
                <div class="giwu-skel-card">
                    <div class="giwu-skel-line w-30 h-3"></div>
                    <div class="giwu-skel-line w-50 h-8"></div>
                    <div class="giwu-skel-line w-40 h-3"></div>
                </div>
            }
        </div>
        break;

    case Shape.Card:
        <div class="giwu-skel-card">
            <div class="giwu-skel-line w-40 h-5"></div>
            <div class="giwu-skel-line w-90 h-3"></div>
            <div class="giwu-skel-line w-80 h-3"></div>
            <div class="giwu-skel-line w-60 h-3"></div>
        </div>
        break;

    case Shape.List:
    default:
        <div class="giwu-skel-list">
            @for (int i = 0; i < (Rows > 0 ? Rows : Count); i++)
            {
                <div class="giwu-skel-row">
                    <div class="giwu-skel-circle"></div>
                    <div class="giwu-skel-stack">
                        <div class="giwu-skel-line w-60 h-4"></div>
                        <div class="giwu-skel-line w-40 h-3"></div>
                    </div>
                    <div class="giwu-skel-line w-20 h-4"></div>
                </div>
            }
        </div>
        break;
}

@code {
    public enum Shape { List, Card, Stat }

    [Parameter] public Shape Variant { get; set; } = Shape.List;

    /// <summary>Number of rows for list variant. Defaults to 5.</summary>
    [Parameter] public int Rows { get; set; } = 5;

    /// <summary>Number of placeholders for stat/grid variants. Defaults to 4.</summary>
    [Parameter] public int Count { get; set; } = 4;
}

<style>
    /* Shared shimmer animation */
    .giwu-skel-line, .giwu-skel-circle {
        background: linear-gradient(
            90deg,
            var(--mud-palette-action-default-hover) 25%,
            color-mix(in srgb, var(--mud-palette-divider) 30%, transparent) 50%,
            var(--mud-palette-action-default-hover) 75%
        );
        background-size: 200% 100%;
        animation: giwu-shimmer 1.2s ease-in-out infinite;
        border-radius: 4px;
    }
    @@keyframes giwu-shimmer {
        0%   { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    /* Sizes */
    .h-3 { height: 10px; }
    .h-4 { height: 12px; }
    .h-5 { height: 14px; }
    .h-8 { height: 28px; }
    .w-20 { width: 20%; }
    .w-30 { width: 30%; }
    .w-40 { width: 40%; }
    .w-50 { width: 50%; }
    .w-60 { width: 60%; }
    .w-80 { width: 80%; }
    .w-90 { width: 90%; }

    /* Stat grid */
    .giwu-skel-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: var(--giwu-space-3);
    }
    .giwu-skel-card {
        padding: var(--giwu-space-5);
        border: var(--giwu-border);
        border-radius: var(--giwu-radius-lg);
        display: flex;
        flex-direction: column;
        gap: var(--giwu-space-3);
    }

    /* List */
    .giwu-skel-list { display: flex; flex-direction: column; gap: var(--giwu-space-3); }
    .giwu-skel-row {
        display: flex;
        align-items: center;
        gap: var(--giwu-space-3);
        padding: var(--giwu-space-3) 0;
        border-bottom: var(--giwu-border);
    }
    .giwu-skel-row:last-child { border-bottom: 0; }
    .giwu-skel-circle { width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0; }
    .giwu-skel-stack { flex: 1; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
</style>
