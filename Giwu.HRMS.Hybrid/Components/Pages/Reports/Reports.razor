    // â”€â”€â”€ Derived â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private int CategoriesUsedCount => ReportDefinitions.Select(d => d.Category).Distinct().Count();
    private int GeneratedThisMonthCount => Runs.Count(r =>
        r.QueuedAt.Year == DateTime.Today.Year && r.QueuedAt.Month == DateTime.Today.Month);
    private int RecentSuccessfulRuns => Runs.Count(r =>
        r.QueuedAt.Year == DateTime.Today.Year && r.QueuedAt.Month == DateTime.Today.Month
        && r.Status == ReportRunStatus.Completed);
    private int ActiveScheduleCount => Schedules.Count(s => s.IsActive);
    private int TotalRecipientsCount =>
        Schedules.Where(s => s.IsActive).SelectMany(s => s.Recipients).Distinct().Count();
    private int ComplianceDueSoonCount => ComplianceDeadlines.Count(c =>
        !c.IsFiled && c.DueDate <= DateTime.Today.AddDays(30));

    private List<ReportDefinition> FilteredDefinitions
    {
        get
        {
            var q = (CatalogSearch ?? "").Trim().ToLower();
            return ReportDefinitions.Where(d =>
                (CatalogCategoryFilter == "All" || CategoryLabel(d.Category) == CatalogCategoryFilter) &&
                (string.IsNullOrEmpty(q)
                    || d.Name.ToLower().Contains(q)
                    || d.ShortDescription.ToLower().Contains(q)
                    || (d.RegulatoryReference?.ToLower().Contains(q) ?? false))
            ).ToList();
        }
    }

    private IEnumerable<ReportRun> FilteredRuns
    {
        get
        {
            var q = (RunSearch ?? "").Trim().ToLower();
            return Runs.Where(r =>
                (RunStatusFilter == "All" || StatusLabel(r.Status) == RunStatusFilter) &&
                (string.IsNullOrEmpty(q)
                    || r.DefinitionName.ToLower().Contains(q)
                    || r.RanBy.ToLower().Contains(q))
            ).OrderByDescending(r => r.QueuedAt);
        }
    }

    // â”€â”€â”€ Actions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private async Task OpenRunReportDialog(string defId)
    {
        var def = ReportDefinitions.FirstOrDefault(d => d.Id == defId);
        if (def == null) return;
        var parameters = new DialogParameters { ["Definition"] = def };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RunReportDialog>($"Run â€” {def.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is ReportRun run)
        {
            run.Id = $"RUN-{Runs.Count + 1:0000}";
            run.RanBy = "Jane Dela Cruz";
            run.RanByInit = "JD";
            run.RanByAv = "primary";
            // Demo: instantly mark as completed with simulated metrics
            run.Status = ReportRunStatus.Completed;
            run.CompletedAt = DateTime.Now.AddSeconds(2);
            run.RowCount = SimulateRowCount(def);
            run.FileSizeBytes = SimulateFileSize(def, run.RowCount, run.Format);
            run.FileName = $"{def.Id}_{run.QueuedAt:yyyyMMdd_HHmmss}.{FormatExtension(run.Format)}";
            Runs.Insert(0, run);
            Snackbar.Add($"Generated {def.Name} ({run.RowCount:N0} rows)", Severity.Success);
        }
    }

    private async Task OpenCustomReportDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditReportTemplateDialog>("New Custom Report", new DialogParameters(), options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is ReportDefinition def)
        {
            def.Id = $"RD-CUSTOM-{ReportDefinitions.Count(d => d.IsCustom) + 1:000}";
            def.IsCustom = true;
            def.CreatedBy = "Jane Dela Cruz";
            def.CreatedOn = DateTime.Now;
            ReportDefinitions.Add(def);
            Snackbar.Add($"Added custom report: {def.Name}", Severity.Success);
        }
    }

    private async Task OpenAddScheduleDialog()
    {
        var parameters = new DialogParameters { ["AllDefinitions"] = ReportDefinitions };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ScheduleReportDialog>("Schedule Report", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is ReportSchedule sched)
        {
            sched.Id = $"SCH-{Schedules.Count + 1:000}";
            sched.CreatedBy = "Jane Dela Cruz";
            sched.CreatedOn = DateTime.Now;
            Schedules.Add(sched);
            Snackbar.Add($"Scheduled: {sched.DefinitionName} â€” {sched.Cadence}", Severity.Success);
        }
    }

    private async Task OpenEditScheduleDialog(string id)
    {
        var sched = Schedules.FirstOrDefault(s => s.Id == id);
        if (sched == null) return;
        var parameters = new DialogParameters
        {
            ["AllDefinitions"] = ReportDefinitions,
            ["Existing"] = sched
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ScheduleReportDialog>($"Edit Schedule â€” {sched.DefinitionName}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            Snackbar.Add($"Updated schedule for {sched.DefinitionName}", Severity.Success);
            StateHasChanged();
        }
    }

    private async Task OpenRunDetail(string id)
    {
        var run = Runs.FirstOrDefault(r => r.Id == id);
        if (run == null) return;
        var def = ReportDefinitions.FirstOrDefault(d => d.Id == run.DefinitionId);
        var parameters = new DialogParameters
        {
            ["Run"] = run,
            ["Definition"] = def
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<ReportRunDetailDialog>("Run Detail", parameters, options);
    }

    private void ToggleSchedule(string id)
    {
        var sched = Schedules.FirstOrDefault(s => s.Id == id);
        if (sched == null) return;
        sched.IsActive = !sched.IsActive;
        Snackbar.Add($"{sched.DefinitionName} {(sched.IsActive ? "resumed" : "paused")}",
            sched.IsActive ? Severity.Success : Severity.Info);
    }

    private void RunScheduleNow(string id)
    {
        var sched = Schedules.FirstOrDefault(s => s.Id == id);
        if (sched == null) return;
        var def = ReportDefinitions.FirstOrDefault(d => d.Id == sched.DefinitionId);
        if (def == null) return;

        var run = new ReportRun
        {
            Id = $"RUN-{Runs.Count + 1:0000}",
            DefinitionId = def.Id,
            DefinitionName = def.Name,
            Category = def.Category,
            Format = sched.Format,
            QueuedAt = DateTime.Now,
            CompletedAt = DateTime.Now.AddSeconds(2),
            Status = ReportRunStatus.Completed,
            RanBy = "(Scheduled run)",
            RanByInit = "SR",
            RanByAv = "purple",
            ScheduleId = sched.Id,
            RowCount = SimulateRowCount(def),
        };
        run.FileSizeBytes = SimulateFileSize(def, run.RowCount, run.Format);
        run.FileName = $"{def.Id}_{run.QueuedAt:yyyyMMdd_HHmmss}.{FormatExtension(run.Format)}";
        Runs.Insert(0, run);
        sched.LastRunAt = DateTime.Now;
        Snackbar.Add($"Ran {def.Name} immediately", Severity.Success);
    }

    private void RunComplianceReport(string deadlineId)
    {
        var deadline = ComplianceDeadlines.FirstOrDefault(c => c.Id == deadlineId);
        if (deadline == null) return;
        if (!string.IsNullOrEmpty(deadline.RelatedReportId))
        {
            _ = OpenRunReportDialog(deadline.RelatedReportId);
