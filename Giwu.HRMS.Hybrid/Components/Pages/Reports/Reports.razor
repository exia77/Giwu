    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            ReloadDefinitionsAsync(),
            ReloadSchedulesAsync(),
            ReloadRunsAsync(),
            ReloadComplianceAsync(),
            LoadLiveSnapshotAsync()
        );
    }

    // ── API → Hybrid model reload helpers ───────────────────────
    private async Task ReloadDefinitionsAsync()
    {
        // Built-in definitions (in code) + custom (from API).
        var combined = SeedDefinitions();
        var res = await ReportsApi.ListDefinitionsAsync();
        if (res.Success && res.Value is not null)
            combined.AddRange(res.Value.Select(MapDefinition));
        ReportDefinitions = combined;
    }

    private async Task ReloadSchedulesAsync()
    {
        var res = await ReportsApi.ListSchedulesAsync();
        if (res.Success && res.Value is not null)
            Schedules = res.Value.Select(MapSchedule).ToList();
    }

    private async Task ReloadRunsAsync()
    {
        var res = await ReportsApi.ListRunsAsync(200);
        if (res.Success && res.Value is not null)
            Runs = res.Value.Select(MapRun).ToList();
    }

    private async Task ReloadComplianceAsync()
    {
        var res = await ReportsApi.ListComplianceAsync();
        if (res.Success && res.Value is not null)
            ComplianceDeadlines = res.Value.Select(MapCompliance).ToList();
    }

