@code {
    private int ActiveTab { get; set; } = 0;

    // Catalog state
    private string CatalogCategoryFilter { get; set; } = "All";
    private string CatalogSearch { get; set; } = "";

    // Schedule state
    private int SchedulePage { get; set; } = 0;
    private int SchedulePageSize { get; set; } = 10;

    // Run history state
    private string RunStatusFilter { get; set; } = "All";
    private string RunSearch { get; set; } = "";
    private int RunPage { get; set; } = 0;
    private int RunPageSize { get; set; } = 25;

    // ─── Derived ────────────────────────────────────────────────
    private int CategoriesUsedCount => ReportDefinitions.Select(d => d.Category).Distinct().Count();
    private int GeneratedThisMonthCount => Runs.Count(r =>
        r.QueuedAt.Year == DateTime.Today.Year && r.QueuedAt.Month == DateTime.Today.Month);
    private int RecentSuccessfulRuns => Runs.Count(r =>
        r.QueuedAt.Year == DateTime.Today.Year && r.QueuedAt.Month == DateTime.Today.Month
        && r.Status == ReportRunStatus.Completed);
    private int ActiveScheduleCount => Schedules.Count(s => s.IsActive);
    private int TotalRecipientsCount =>
        Schedules.Where(s => s.IsActive).SelectMany(s => s.Recipients).Distinct().Count();
    private int ComplianceDueSoonCount => ComplianceDeadlines.Count(c =>
        !c.IsFiled && c.DueDate <= DateTime.Today.AddDays(30));

    private List<ReportDefinition> FilteredDefinitions
    {
        get
        {
            var q = (CatalogSearch ?? "").Trim().ToLower();
            return ReportDefinitions.Where(d =>
                (CatalogCategoryFilter == "All" || CategoryLabel(d.Category) == CatalogCategoryFilter) &&
                (string.IsNullOrEmpty(q)
                    || d.Name.ToLower().Contains(q)
                    || d.ShortDescription.ToLower().Contains(q)
                    || (d.RegulatoryReference?.ToLower().Contains(q) ?? false))
            ).ToList();
        }
    }

    private IEnumerable<ReportRun> FilteredRuns
    {
        get
        {
            var q = (RunSearch ?? "").Trim().ToLower();
            return Runs.Where(r =>
                (RunStatusFilter == "All" || StatusLabel(r.Status) == RunStatusFilter) &&
                (string.IsNullOrEmpty(q)
                    || r.DefinitionName.ToLower().Contains(q)
                    || r.RanBy.ToLower().Contains(q))
            ).OrderByDescending(r => r.QueuedAt);
        }
    }

    // ─── Actions ────────────────────────────────────────────────

    /// <summary>Catalog-card click handler. Read-only roles (e.g. Manager
    /// with reports.view but not reports.run) get a no-op; their UI is
    /// already styled as non-actionable via .catalog-card.is-readonly.</summary>
    private Task HandleCatalogClick(string defId) =>
        RoleAuth.Can("reports.run") ? OpenRunReportDialog(defId) : Task.CompletedTask;

    private async Task OpenRunReportDialog(string defId)
    {
        var def = ReportDefinitions.FirstOrDefault(d => d.Id == defId);
        if (def == null) return;
        var parameters = new DialogParameters { ["Definition"] = def };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RunReportDialog>($"Run — {def.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is ReportRun run)
        {
            var req = new Giwu.Contracts.Reports.QueueReportRunRequest(
                DefinitionId: def.Id,
                DefinitionName: def.Name,
                Category: (Giwu.Domain.Reports.ReportCategory)(int)def.Category,
                Format: (Giwu.Domain.Reports.ReportFormat)(int)run.Format,
                PeriodStart: run.PeriodStart,
                PeriodEnd: run.PeriodEnd,
                Departments: run.Departments ?? new List<string>());
            var apiResult = await ReportsApi.QueueRunAsync(req);
            if (apiResult.Success)
            {
                await ReloadRunsAsync();
                var rows = apiResult.Value?.RowCount ?? 0;
                Snackbar.Add($"Generated {def.Name} ({rows:N0} rows)", Severity.Success);
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to queue report run.", Severity.Error);
            }
        }
    }

    private async Task OpenEditCustomReportDialog(string id)
    {
        var def = ReportDefinitions.FirstOrDefault(d => d.Id == id);
        if (def == null || !def.IsCustom) return;
        if (!Guid.TryParse(def.Id, out var guid)) { Snackbar.Add("Invalid definition id", Severity.Error); return; }

        var parameters = new DialogParameters { ["Existing"] = def };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditReportTemplateDialog>($"Edit — {def.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is ReportDefinition edited)
        {
            var req = new Giwu.Contracts.Reports.UpdateReportDefinitionRequest(
                Name: edited.Name,
                ShortDescription: edited.ShortDescription,
                LongDescription: edited.LongDescription,
                Category: (Giwu.Domain.Reports.ReportCategory)(int)edited.Category,
                RequiresDateRange: edited.RequiresDateRange,
                RequiresDepartmentFilter: edited.RequiresDepartmentFilter,
                SupportedFormats: edited.SupportedFormats.Select(f => (Giwu.Domain.Reports.ReportFormat)(int)f).ToList(),
                Columns: edited.Columns ?? new List<string>());
            var apiResult = await ReportsApi.UpdateDefinitionAsync(guid, req);
            if (apiResult.Success)
            {
                await ReloadDefinitionsAsync();
                Snackbar.Add($"Updated: {edited.Name}", Severity.Success);
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to update report.", Severity.Error);
            }
        }
    }

    private async Task DeleteCustomReport(string id)
    {
        var def = ReportDefinitions.FirstOrDefault(d => d.Id == id);
        if (def == null || !def.IsCustom) return;
        if (!Guid.TryParse(def.Id, out var guid)) { Snackbar.Add("Invalid definition id", Severity.Error); return; }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Permanently delete \"{def.Name}\"?\n\nExisting run history is preserved.");
        if (!confirmed) return;

        var apiResult = await ReportsApi.DeleteDefinitionAsync(guid);
        if (apiResult.Success)
        {
            await ReloadDefinitionsAsync();
            Snackbar.Add($"Deleted: {def.Name}", Severity.Warning);
        }
        else
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to delete report.", Severity.Error);
        }
    }

    private async Task DeleteSchedule(string id)
    {
        var sched = Schedules.FirstOrDefault(s => s.Id == id);
        if (sched == null) return;
        if (!Guid.TryParse(sched.Id, out var guid)) { Snackbar.Add("Invalid schedule id", Severity.Error); return; }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Stop scheduled runs of \"{sched.DefinitionName}\"?\n\nThe report definition is unaffected.");
        if (!confirmed) return;

        var apiResult = await ReportsApi.DeleteScheduleAsync(guid);
        if (apiResult.Success)
        {
            await ReloadSchedulesAsync();
            Snackbar.Add($"Deleted schedule for {sched.DefinitionName}", Severity.Warning);
        }
        else
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to delete schedule.", Severity.Error);
        }
    }

    private async Task OpenAddComplianceDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditComplianceDialog>("Add compliance deadline", new DialogParameters(), options);
        var result = await dialog.Result;
