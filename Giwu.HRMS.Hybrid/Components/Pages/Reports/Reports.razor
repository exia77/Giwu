    private void SeedRuns()
    {
        var rng = new Random(42);
        var runners = new[] {
            ("Jane Dela Cruz", "JD", "primary"),
            ("Nadia Lim",      "NL", "green"),
            ("Liza Mendoza",   "LM", "amber"),
            ("(Scheduled run)","SR", "purple"),
        };
        var counter = 0;

        for (int i = 0; i < 30; i++)
        {
            counter++;
            var def = ReportDefinitions[rng.Next(ReportDefinitions.Count)];
            var runner = runners[rng.Next(runners.Length)];
            var queuedAt = DateTime.Now.AddHours(-rng.Next(1, 24 * 60));
            var status = rng.NextDouble() switch
            {
                < 0.05 => ReportRunStatus.Failed,
                < 0.10 => ReportRunStatus.Running,
                _      => ReportRunStatus.Completed
            };
            var rowCount = status == ReportRunStatus.Completed ? SimulateRowCount(def) + rng.Next(-5, 10) : 0;
            var fmt = def.SupportedFormats[rng.Next(def.SupportedFormats.Count)];

            Runs.Add(new ReportRun
            {
                Id = $"RUN-{counter:0000}",
                DefinitionId = def.Id, DefinitionName = def.Name, Category = def.Category,
                Format = fmt,
                QueuedAt = queuedAt,
                CompletedAt = status == ReportRunStatus.Completed ? queuedAt.AddSeconds(rng.Next(2, 30)) : null,
                Status = status,
                RanBy = runner.Item1, RanByInit = runner.Item2, RanByAv = runner.Item3,
                ScheduleId = runner.Item1 == "(Scheduled run)" ? Schedules.ElementAtOrDefault(rng.Next(Schedules.Count))?.Id : null,
                PeriodStart = def.RequiresDateRange ? queuedAt.AddDays(-30).Date : null,
                PeriodEnd = def.RequiresDateRange ? queuedAt.Date : null,
                RowCount = rowCount,
                FileSizeBytes = status == ReportRunStatus.Completed ? SimulateFileSize(def, rowCount, fmt) : 0,
                FileName = status == ReportRunStatus.Completed ? $"{def.Id}_{queuedAt:yyyyMMdd_HHmmss}.{FormatExtension(fmt)}" : null,
                ErrorMessage = status == ReportRunStatus.Failed ? "Source data unavailable for the selected period." : null,
            });
        }
    }
