@page "/reports"
@using static Giwu.HRMS.Hybrid.Models.ReportsFormatting
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@using Pages.Reports.Components

<PageTitle>Reports</PageTitle>

@* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   KPI STRIP
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="rep-kpi" Elevation="0">
            <div class="kpi-label">Reports Available</div>
            <div class="kpi-value">@ReportDefinitions.Count</div>
            <div class="kpi-sub">
                <span class="kpi-dot" style="background:var(--rep-green)"></span>
                <span>across @CategoriesUsedCount categories</span>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="rep-kpi" Elevation="0">
            <div class="kpi-label">Generated This Month</div>
            <div class="kpi-value">@GeneratedThisMonthCount</div>
            <div class="kpi-sub">
                <span class="kpi-dot" style="background:var(--rep-blue)"></span>
                <span>@RecentSuccessfulRuns successful</span>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="rep-kpi" Elevation="0">
            <div class="kpi-label">Scheduled Reports</div>
            <div class="kpi-value">@ActiveScheduleCount</div>
            <div class="kpi-sub">
                <span class="kpi-dot" style="background:var(--rep-purple)"></span>
                <span>@TotalRecipientsCount recipients total</span>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="rep-kpi" Elevation="0">
            <div class="kpi-label">Compliance Due Soon</div>
            <div class="kpi-value">@ComplianceDueSoonCount</div>
            <div class="kpi-sub">
                <span class="kpi-dot" style="background:var(--rep-amber)"></span>
                <span>within 30 days</span>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   MIDDLE ROW: COMPLIANCE CALENDAR + RECENT RUNS
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
<MudGrid Spacing="3" Class="mb-4">
    @* â”€â”€ Compliance calendar â”€â”€ *@
    <MudItem xs="12" md="7">
        <MudPaper Class="rep-card" Elevation="0">
            <div class="rep-card-header">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="fw-medium">Compliance Calendar</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.55">Statutory filing deadlines</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="height:20px;font-size:.7rem">
                    Next 60 days
                </MudChip>
            </div>
            @{
                var upcoming = ComplianceDeadlines
                    .Where(c => !c.IsFiled && c.DueDate <= DateTime.Today.AddDays(60))
                    .OrderBy(c => c.DueDate)
                    .ToList();
            }
            @if (upcoming.Count == 0)
            {
                <div class="rep-empty">
                    <div class="rep-empty-icon">âœ“</div>
                    <MudText Typo="Typo.body2">No filings due in the next 60 days.</MudText>
                </div>
            }
            else
            {
                @foreach (var c in upcoming.Take(6))
                {
                    var severity = DaysUntilSeverity(c.DueDate, c.IsFiled);
                    <div class="compliance-row" @onclick="@(() => RunComplianceReport(c.Id))">
                        <div class="@($"compliance-date severity-{severity}")">
                            <div class="compliance-mo">@c.DueDate.ToString("MMM").ToUpper()</div>
                            <div class="compliance-day">@c.DueDate.Day</div>
                        </div>
                        <div class="compliance-meta">
                            <div class="compliance-headline">
                                <span class="@($"rep-agency {AgencyBadgeClass(c.Agency)}")">@c.Agency</span>
                                <span class="fw-medium">@c.FormCode</span>
                                <span style="opacity:.7">â€” @c.Name</span>
                            </div>
                            <div class="compliance-detail">
                                @c.PeriodCovered Â· @DaysUntilLabel(c.DueDate)
                            </div>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow" Size="Size.Small"
                                       Title="Run filing report" Color="Color.Primary"
                                       OnClick="@(() => RunComplianceReport(c.Id))" />
                    </div>
                }
            }
        </MudPaper>
    </MudItem>

    @* â”€â”€ Recent runs â”€â”€ *@
    <MudItem xs="12" md="5">
        <MudPaper Class="rep-card" Elevation="0">
            <div class="rep-card-header">
                <MudText Typo="Typo.subtitle2" Class="fw-medium">Recent Runs</MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           OnClick="@(() => ActiveTab = 2)">View all</MudButton>
            </div>
            @{
                var recent = Runs.OrderByDescending(r => r.QueuedAt).Take(5).ToList();
            }
            @if (recent.Count == 0)
            {
                <div class="rep-empty">
                    <div class="rep-empty-icon">â€”</div>
                    <MudText Typo="Typo.body2">No runs yet.</MudText>
                </div>
            }
            else
            {
                @foreach (var run in recent)
                {
                    <div class="recent-row" @onclick="@(() => OpenRunDetail(run.Id))">
                        <div class="recent-format">
                            <MudIcon Icon="@FormatIcon(run.Format)" Size="Size.Small" Style="opacity:.7" />
                        </div>
                        <div class="recent-meta">
                            <div class="recent-name">@run.DefinitionName</div>
                            <div class="recent-detail">
                                @RelativeTime(run.QueuedAt) Â· @run.RanBy
                                @if (run.Status == ReportRunStatus.Completed && run.RowCount > 0)
                                {
                                    <span> Â· @run.RowCount.ToString("N0") rows</span>
                                }
                            </div>
                        </div>
                        <span class="@($"rep-status {StatusBadgeClass(run.Status)}")">@StatusLabel(run.Status)</span>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   MAIN TABS
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
<MudPaper Class="rep-card" Elevation="0">
    <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
             PanelClass="rep-tab-panel" TabPanelClass="rep-tab-item"
             @bind-ActivePanelIndex="ActiveTab">

        @* â•â• CATALOG TAB â•â• *@
        <MudTabPanel Text="@($"Report Catalog ({ReportDefinitions.Count})")"
                     Icon="@Icons.Material.Outlined.LibraryBooks">
            <div class="rep-card-header">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="fw-medium">Available Reports</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.55">
                        Click any card to configure and run
                    </MudText>
                </div>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Add"
                           OnClick="OpenCustomReportDialog">Custom Report</MudButton>
            </div>

            <div class="catalog-filter-row">
                <MudChipSet T="string" @bind-SelectedValue="CatalogCategoryFilter" CheckMark="false" Mandatory="true">
                    <MudChip T="string" Value="@("All")" Size="Size.Small">All</MudChip>
                    @foreach (var cat in Enum.GetValues<ReportCategory>())
                    {
                        <MudChip T="string" Value="@CategoryLabel(cat)" Size="Size.Small">@CategoryLabel(cat)</MudChip>
                    }
                </MudChipSet>
                <MudSpacer />
                <MudTextField @bind-Value="CatalogSearch" Placeholder="Search reportsâ€¦"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="rep-search"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              DebounceInterval="200" Immediate="true" />
            </div>

            @if (FilteredDefinitions.Count == 0)
            {
                <div class="rep-empty">
                    <div class="rep-empty-icon">âŠ˜</div>
                    <MudText Typo="Typo.body2">No reports match your filter.</MudText>
                </div>
            }
            else
            {
                <div class="catalog-grid">
                    @foreach (var def in FilteredDefinitions)
                    {
                        <div class="catalog-card" @onclick="@(() => OpenRunReportDialog(def.Id))">
                            <div class="catalog-card-head">
                                <div class="@($"catalog-icon {CategoryBadgeClass(def.Category)}")">
                                    <MudIcon Icon="@CategoryIcon(def.Category)" Size="Size.Small" />
                                </div>
                                <div class="catalog-card-meta">
                                    <div class="catalog-card-title">
                                        <span>@def.Name</span>
                                        @if (def.IsCompliance)
                                        {
                                            <span class="rep-compliance-chip">Compliance</span>
                                        }
                                        @if (def.IsCustom)
                                        {
                                            <span class="rep-custom-chip">Custom</span>
                                        }
                                    </div>
                                    <span class="@($"rep-badge {CategoryBadgeClass(def.Category)}")">
                                        @CategoryLabel(def.Category)
                                    </span>
                                </div>
                            </div>
                            <div class="catalog-card-desc">@def.ShortDescription</div>
                            <div class="catalog-card-footer">
                                @if (!string.IsNullOrEmpty(def.RegulatoryReference))
                                {
                                    <span class="catalog-ref">
                                        <MudIcon Icon="@Icons.Material.Outlined.Gavel" Size="Size.Small" Style="opacity:.6" />
                                        @def.RegulatoryReference
                                    </span>
                                }
                                else
                                {
                                    <span class="catalog-cols">@def.Columns.Count columns</span>
                                }
                                <div class="catalog-formats">
                                    @foreach (var fmt in def.SupportedFormats)
                                    {
                                        <span class="catalog-format-chip" title="@FormatLabel(fmt)">@FormatLabel(fmt)</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </MudTabPanel>

        @* â•â• SCHEDULED TAB â•â• *@
        <MudTabPanel Text="@($"Scheduled ({Schedules.Count(s => s.IsActive)})")"
                     Icon="@Icons.Material.Outlined.Schedule">
            <div class="rep-card-header">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="fw-medium">Scheduled Reports</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.55">
                        Reports that run automatically on a recurring basis
                    </MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.AddAlert" DisableElevation="true"
                           OnClick="OpenAddScheduleDialog">Add Schedule</MudButton>
            </div>

            <MudTable T="ReportSchedule" Items="@Schedules" Dense="true" Hover="true"
                      Elevation="0" Breakpoint="Breakpoint.Sm"
                      @bind-RowsPerPage="SchedulePageSize" @bind-Page="SchedulePage"
                      Class="rep-mud-table">
                <HeaderContent>
                    <MudTh><MudTableSortLabel T="ReportSchedule" SortBy="@(s => s.DefinitionName)">Report</MudTableSortLabel></MudTh>
                    <MudTh>Cadence</MudTh>
                    <MudTh>Recipients</MudTh>
                    <MudTh>Format</MudTh>
                    <MudTh>Last Run</MudTh>
                    <MudTh>Next Run</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Report">
                        <div style="display:flex;align-items:center;gap:9px">
                            <div class="@($"catalog-icon-sm {CategoryBadgeClass(context.Category)}")">
                                <MudIcon Icon="@CategoryIcon(context.Category)" Size="Size.Small" />
                            </div>
                            <MudText Typo="Typo.body2" Class="fw-medium">@context.DefinitionName</MudText>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Cadence" Style="font-size:12.5px;opacity:.85">@context.Cadence</MudTd>
                    <MudTd DataLabel="Recipients" Style="font-size:12.5px">
                        @if (context.Recipients.Count == 0)
                        {
                            <span style="opacity:.4">â€”</span>
                        }
                        else if (context.Recipients.Count == 1)
                        {
                            <span>@context.Recipients[0]</span>
                        }
                        else
                        {
                            <span>@context.Recipients[0] +@(context.Recipients.Count - 1)</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Format">
                        <span class="catalog-format-chip">@FormatLabel(context.Format)</span>
                    </MudTd>
                    <MudTd DataLabel="Last Run" Style="opacity:.7;font-size:12px">
                        @(context.LastRunAt.HasValue ? RelativeTime(context.LastRunAt.Value) : "â€”")
                    </MudTd>
                    <MudTd DataLabel="Next Run" Style="font-size:12px">
                        @if (context.IsActive)
                        {
                            <span>@RelativeTime(context.NextRunAt)</span>
                        }
                        else
                        {
                            <span style="opacity:.4">paused</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.IsActive)
                        {
                            <span class="rep-status rep-status-completed">Active</span>
                        }
                        else
                        {
                            <span class="rep-status rep-status-paused">Paused</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Outlined.Pause : Icons.Material.Outlined.PlayArrow)"
                                           Size="Size.Small"
                                           Title="@(context.IsActive ? "Pause" : "Resume")"
                                           OnClick="@(() => ToggleSchedule(context.Id))" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                           OnClick="@(() => OpenEditScheduleDialog(context.Id))" />
                            <MudIconButton Icon="@Icons.Material.Outlined.PlayCircle" Size="Size.Small"
                                           Title="Run now" Color="Color.Primary"
                                           OnClick="@(() => RunScheduleNow(context.Id))" />
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="rep-empty">
                        <div class="rep-empty-icon">âŠ˜</div>
                        <MudText Typo="Typo.body2">No scheduled reports configured.</MudText>
                    </div>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                </PagerContent>
            </MudTable>
        </MudTabPanel>

        @* â•â• HISTORY TAB â•â• *@
        <MudTabPanel Text="@($"History ({Runs.Count})")"
                     Icon="@Icons.Material.Outlined.History">
            <div class="rep-card-header">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="fw-medium">Run History</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.55">
                        @FilteredRuns.Count() of @Runs.Count runs
                    </MudText>
                </div>
            </div>

            <div class="catalog-filter-row">
                <MudChipSet T="string" @bind-SelectedValue="RunStatusFilter" CheckMark="false" Mandatory="true">
                    <MudChip T="string" Value="@("All")" Size="Size.Small">All</MudChip>
                    <MudChip T="string" Value="@("Running")" Size="Size.Small">Running</MudChip>
                    <MudChip T="string" Value="@("Completed")" Size="Size.Small">Completed</MudChip>
                    <MudChip T="string" Value="@("Failed")" Size="Size.Small">Failed</MudChip>
                </MudChipSet>
                <MudSpacer />
                <MudTextField @bind-Value="RunSearch" Placeholder="Search report, runnerâ€¦"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="rep-search"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              DebounceInterval="200" Immediate="true" />
            </div>

            <MudTable T="ReportRun" Items="@FilteredRuns" Dense="true" Hover="true"
                      Elevation="0" Breakpoint="Breakpoint.Sm"
                      @bind-RowsPerPage="RunPageSize" @bind-Page="RunPage"
                      Class="rep-mud-table">
                <HeaderContent>
                    <MudTh><MudTableSortLabel T="ReportRun" SortBy="@(r => r.QueuedAt)">Run At</MudTableSortLabel></MudTh>
                    <MudTh>Report</MudTh>
                    <MudTh>Period</MudTh>
                    <MudTh>Run By</MudTh>
                    <MudTh>Format</MudTh>
                    <MudTh Style="text-align:right">Rows</MudTh>
                    <MudTh Style="text-align:right">Size</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Run At" Style="font-size:12px">
                        <div>@FmtDateShort(context.QueuedAt)</div>
                        <div style="opacity:.55;font-size:11px">@context.QueuedAt.ToString("h:mm tt")</div>
                    </MudTd>
                    <MudTd DataLabel="Report">
                        <div style="display:flex;align-items:center;gap:9px">
                            <div class="@($"catalog-icon-sm {CategoryBadgeClass(context.Category)}")">
                                <MudIcon Icon="@CategoryIcon(context.Category)" Size="Size.Small" />
                            </div>
                            <div>
                                <MudText Typo="Typo.body2" Class="fw-medium" Style="line-height:1.2">@context.DefinitionName</MudText>
                                @if (!string.IsNullOrEmpty(context.ScheduleId))
                                {
                                    <MudText Typo="Typo.caption" Style="opacity:.55">scheduled</MudText>
                                }
                            </div>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Period" Style="font-size:12px;opacity:.8">
                        @if (context.PeriodStart.HasValue && context.PeriodEnd.HasValue)
                        {
                            <span>@FmtDateShort(context.PeriodStart.Value) â€“ @FmtDateShort(context.PeriodEnd.Value)</span>
                        }
                        else
                        {
                            <span style="opacity:.4">â€”</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Run By">
                        <div style="display:flex;align-items:center;gap:8px">
                            <MudAvatar Style="@AvatarStyle(context.RanByAv)" Class="rep-av-sm">@context.RanByInit</MudAvatar>
                            <span style="font-size:12.5px">@context.RanBy</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Format">
                        <span class="catalog-format-chip">@FormatLabel(context.Format)</span>
                    </MudTd>
                    <MudTd DataLabel="Rows" Style="text-align:right;font-variant-numeric:tabular-nums">
                        @if (context.RowCount > 0)
                        {
                            @context.RowCount.ToString("N0")
                        }
                        else
                        {
                            <span style="opacity:.4">â€”</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Size" Style="text-align:right;font-size:12px">
                        @if (context.FileSizeBytes > 0)
                        {
                            @FmtFileSize(context.FileSizeBytes)
                        }
                        else
                        {
                            <span style="opacity:.4">â€”</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <span class="@($"rep-status {StatusBadgeClass(context.Status)}")">@StatusLabel(context.Status)</span>
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            @if (context.Status == ReportRunStatus.Completed)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Download" Size="Size.Small"
                                               Title="Download"
                                               OnClick="@(() => DownloadRun(context.Id))" />
                            }
                            <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small"
                                           OnClick="@(() => OpenRunDetail(context.Id))" />
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="rep-empty">
                        <div class="rep-empty-icon">âŠ˜</div>
                        <MudText Typo="Typo.body2">No runs match your filter.</MudText>
                    </div>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                </PagerContent>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   STYLES
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
<style>
    :root {
        --rep-green:        #1D9E75;
        --rep-green-light:  #E1F5EE;
        --rep-green-text:   #085041;
        --rep-red:          #E24B4A;
        --rep-red-light:    #FCEBEB;
        --rep-red-text:     #791F1F;
