    private static int SimulateRowCount(ReportDefinition def) => def.Category switch
    {
        ReportCategory.Payroll     => 18,
        ReportCategory.Attendance  => 432,
        ReportCategory.People      => 18,
        ReportCategory.Recruitment => 47,
        ReportCategory.Benefits    => 113,
        ReportCategory.Leave       => 24,
        ReportCategory.Compliance  => 18,
        _ => 50
    };

    private static long SimulateFileSize(ReportDefinition def, int rows, ReportFormat fmt)
    {
        var baseBytes = rows * 200L;
        return fmt switch
        {
            ReportFormat.Csv   => baseBytes,
            ReportFormat.Excel => baseBytes * 5,
            ReportFormat.Pdf   => baseBytes * 8,
            _ => baseBytes
        };
    }

