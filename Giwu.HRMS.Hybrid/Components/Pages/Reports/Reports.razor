                Description:       d.Description ?? "",
                DueDate:           DateOnly.FromDateTime(d.DueDate),
                PeriodCovered:     d.PeriodCovered ?? "",
                RelatedReportCode: string.IsNullOrWhiteSpace(d.RelatedReportId) ? null : d.RelatedReportId);

            var apiResult = await ReportsApi.CreateComplianceAsync(req);
            if (apiResult.Success)
            {
                await ReloadComplianceAsync();
                Snackbar.Add($"Added: {d.Agency} {d.FormCode}", Severity.Success);
