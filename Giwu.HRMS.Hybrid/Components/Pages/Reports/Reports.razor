    private async Task MarkComplianceFiled(string id)
    {
        var c = ComplianceDeadlines.FirstOrDefault(x => x.Id == id);
        if (c == null) return;
        if (!Guid.TryParse(c.Id, out var guid)) { Snackbar.Add("Invalid deadline id", Severity.Error); return; }
