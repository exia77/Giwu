    private async Task LoadLiveSnapshotAsync()
    {
        LiveLoading = true;
        LiveError = null;
        StateHasChanged();
        try
        {
            var headTask = ReportsApi.HeadcountAsync();
            var attTask  = ReportsApi.AttendanceAsync();
            var lvTask   = ReportsApi.LeaveAsync();
            var payTask  = ReportsApi.PayrollAsync();
            await Task.WhenAll(headTask, attTask, lvTask, payTask);

            var head = headTask.Result;
            var att  = attTask.Result;
            var lv   = lvTask.Result;
            var pay  = payTask.Result;

            Headcount  = head.Success ? head.Value  : null;
            Attendance = att.Success  ? att.Value   : null;
            Leave      = lv.Success   ? lv.Value    : null;
            Payroll    = pay.Success  ? pay.Value   : null;

            var failures = new[] { head.ErrorMessage, att.ErrorMessage, lv.ErrorMessage, pay.ErrorMessage }
                .Where(e => !string.IsNullOrEmpty(e))
                .Distinct()
                .ToList();
            if (failures.Count > 0) LiveError = string.Join(" · ", failures!);

            LiveLoadedAt = DateTime.Now;
        }
        catch (Exception ex)
        {
            LiveError = ex.Message;
        }
        finally
        {
            LiveLoading = false;
            StateHasChanged();
        }
    }

