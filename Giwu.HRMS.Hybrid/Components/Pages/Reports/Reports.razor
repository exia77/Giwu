                Recipients: updated.Recipients ?? new List<string>(),
                Format: (Giwu.Domain.Reports.ReportFormat)(int)updated.Format,
                NextRunAt: updated.NextRunAt,
                IsActive: updated.IsActive);
            var apiResult = await ReportsApi.UpdateScheduleAsync(guid, req);
            if (apiResult.Success)
            {
                await ReloadSchedulesAsync();
                Snackbar.Add($"Updated schedule for {updated.DefinitionName}", Severity.Success);
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to update schedule.", Severity.Error);
            }
        }
    }

    private async Task OpenRunDetail(string id)
    {
        var run = Runs.FirstOrDefault(r => r.Id == id);
        if (run == null) return;
        var def = ReportDefinitions.FirstOrDefault(d => d.Id == run.DefinitionId);
        var parameters = new DialogParameters
        {
            ["Run"] = run,
            ["Definition"] = def
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ReportRunDetailDialog>("Run Detail", parameters, options);
        var result = await dialog.Result;
        // Dialog returns true when the user clicks Download — re-use the same
        // CSV-export pipeline as the inline download button.
        if (result is { Canceled: false, Data: true })
            await DownloadRun(id);
    }

    private async Task ToggleSchedule(string id)
    {
        if (!Guid.TryParse(id, out var guid)) return;
        var sched = Schedules.FirstOrDefault(s => s.Id == id);
        if (sched == null) return;
        var apiResult = await ReportsApi.ToggleScheduleAsync(guid);
        if (apiResult.Success)
        {
            await ReloadSchedulesAsync();
            var updated = Schedules.FirstOrDefault(s => s.Id == id);
            Snackbar.Add($"{sched.DefinitionName} {(updated?.IsActive == true ? "resumed" : "paused")}",
                updated?.IsActive == true ? Severity.Success : Severity.Info);
        }
        else
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to toggle schedule.", Severity.Error);
        }
    }

    private async Task RunScheduleNow(string id)
    {
        var sched = Schedules.FirstOrDefault(s => s.Id == id);
        if (sched == null) return;
        var def = ReportDefinitions.FirstOrDefault(d => d.Id == sched.DefinitionId);
        if (def == null) return;

        var req = new Giwu.Contracts.Reports.QueueReportRunRequest(
            DefinitionId: def.Id,
            DefinitionName: def.Name,
            Category: (Giwu.Domain.Reports.ReportCategory)(int)def.Category,
            Format: (Giwu.Domain.Reports.ReportFormat)(int)sched.Format,
            PeriodStart: null,
            PeriodEnd: null,
            Departments: new List<string>());
        var apiResult = await ReportsApi.QueueRunAsync(req);
        if (apiResult.Success)
        {
            await ReloadRunsAsync();
            Snackbar.Add($"Ran {def.Name} immediately", Severity.Success);
        }
        else
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to run schedule.", Severity.Error);
        }
    }

    private void RunComplianceReport(string deadlineId)
    {
        var deadline = ComplianceDeadlines.FirstOrDefault(c => c.Id == deadlineId);
        if (deadline == null) return;
        if (!string.IsNullOrEmpty(deadline.RelatedReportId))
        {
            _ = OpenRunReportDialog(deadline.RelatedReportId);
        }
        else
        {
            Snackbar.Add($"No report linked for {deadline.Agency} {deadline.FormCode}.", Severity.Warning);
        }
    }

    private async Task DownloadRun(string id)
    {
        var run = Runs.FirstOrDefault(r => r.Id == id);
        if (run == null) return;
        if (run.Status != ReportRunStatus.Completed)
        {
            Snackbar.Add("Run is not completed yet.", Severity.Warning);
            return;
        }

        var def = ReportDefinitions.FirstOrDefault(d => d.Id == run.DefinitionId);
        if (def == null)
        {
            Snackbar.Add("Report definition not found.", Severity.Error);
            return;
        }

        Snackbar.Add($"Preparing {run.FileName}…", Severity.Info);
        try
        {
            var csv = await BuildCsvForCategoryAsync(def.Category, run);

            // Pick the extension that matches the user's chosen format, then
            // generate real content for it (xlsx via ClosedXML, pdf via QuestPDF,
            // raw CSV bytes otherwise).
            var ext = run.Format switch
            {
                ReportFormat.Excel => ".xlsx",
                ReportFormat.Pdf   => ".pdf",
                _                  => ".csv",
            };
            var filename = System.IO.Path.ChangeExtension(
                run.FileName ?? $"{def.Id}{ext}", ext.TrimStart('.'));

            byte[] content;
            long realSize;
            switch (run.Format)
            {
                case ReportFormat.Excel:
                    content = ReportExporter.BuildExcel(def.Name, csv.Csv);
                    realSize = content.LongLength;
                    break;
                case ReportFormat.Pdf:
                    content = ReportExporter.BuildPdf(
                        def.Name,
                        csv.Csv,
                        companyName: Theme.CompanyName,
                        periodText: BuildPeriodText(run),
                        accentHex: AppSettings.AccentColor);
                    realSize = content.LongLength;
                    break;
                default:
                    content = System.Text.Encoding.UTF8.GetBytes(csv.Csv);
                    realSize = csv.SizeBytes;
                    break;
            }

            await TriggerBlobDownloadAsync(content, filename!, ReportExporter.MimeFor(ext));
            run.RowCount = csv.RowCount;
            run.FileSizeBytes = realSize;
            StateHasChanged();
            Snackbar.Add($"Downloaded {filename} ({FmtFileSize(csv.SizeBytes)})", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Download failed: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Pulls the right dataset from the API for a given report category and
    /// converts it to a CSV string. Returns the CSV plus row count + byte size
    /// so the caller can update the run summary.
    /// </summary>
    private async Task<CsvPayload> BuildCsvForCategoryAsync(ReportCategory category, ReportRun run)
    {
        var sb = new System.Text.StringBuilder();
        var rowCount = 0;

        switch (category)
        {
            case ReportCategory.Payroll:
            {
                sb.AppendLine("Employee,Employee Number,Department,Job Title,Basic,Overtime,Bonus,Allowance,Gross,SSS,PhilHealth,Pag-IBIG,WHT,Loan,Other,Total Deductions,Net");
                var slips = await PayrollApi.ListPayslipsAsync();
                if (slips.Success && slips.Value is not null)
                    foreach (var s in slips.Value)
                    {
                        sb.AppendLine(string.Join(",", new[] {
                            CsvEscape(s.EmployeeName), CsvEscape(s.EmployeeNumber),
                            CsvEscape(s.DepartmentName), CsvEscape(s.JobTitle),
                            s.BasicSalary.ToString("F2"), s.Overtime.ToString("F2"),
                            s.Bonus.ToString("F2"), s.Allowance.ToString("F2"),
                            s.Gross.ToString("F2"),
                            s.Sss.ToString("F2"), s.PhilHealth.ToString("F2"),
                            s.PagIbig.ToString("F2"), s.WithholdingTax.ToString("F2"),
                            s.LoanDeduction.ToString("F2"), s.OtherDeduction.ToString("F2"),
                            s.TotalDeductions.ToString("F2"), s.Net.ToString("F2"),
                        }));
                        rowCount++;
                    }
                break;
            }
            case ReportCategory.Attendance:
            {
                sb.AppendLine("Employee,Date,Status,Clock In,Clock Out,Late Min,OT Min,Notes");
                var from = run.PeriodStart.HasValue ? DateOnly.FromDateTime(run.PeriodStart.Value) : DateOnly.FromDateTime(DateTime.Today.AddDays(-30));
                var to   = run.PeriodEnd.HasValue   ? DateOnly.FromDateTime(run.PeriodEnd.Value)   : DateOnly.FromDateTime(DateTime.Today);
                var att = await AttendanceApi.ListAsync(from, to, null, page: 1, pageSize: 5000);
                if (att.Success && att.Value is not null)
                    foreach (var a in att.Value.Items)
                    {
                        sb.AppendLine(string.Join(",", new[] {
                            CsvEscape(a.EmployeeName),
                            a.Date.ToString("yyyy-MM-dd"),
                            a.Status.ToString(),
                            a.ClockIn?.ToString("yyyy-MM-dd HH:mm") ?? "",
                            a.ClockOut?.ToString("yyyy-MM-dd HH:mm") ?? "",
                            a.LateMinutes?.ToString() ?? "",
                            a.OvertimeApprovedMinutes?.ToString() ?? "",
                            CsvEscape(a.Notes),
                        }));
                        rowCount++;
                    }
                break;
            }
            case ReportCategory.People:
            {
                sb.AppendLine("Employee Number,First Name,Last Name,Email,Department,Job Title,Status,Employment Type,Hire Date");
                var emps = await EmployeesApi.ListAsync(page: 1, pageSize: 500);
                if (emps.Success && emps.Value is not null)
                    foreach (var e in emps.Value.Items)
                    {
                        sb.AppendLine(string.Join(",", new[] {
                            CsvEscape(e.EmployeeNumber), CsvEscape(e.FirstName), CsvEscape(e.LastName),
                            CsvEscape(e.Email), CsvEscape(e.DepartmentName), CsvEscape(e.JobTitle),
                            e.Status.ToString(), e.EmploymentType.ToString(),
                            e.HireDate.ToString("yyyy-MM-dd"),
                        }));
                        rowCount++;
                    }
                break;
            }
            case ReportCategory.Leave:
            {
                sb.AppendLine("Employee,Leave Type,Start,End,Days,Status,Reason,Filed At");
                var leaves = await LeavesApi.ListRequestsAsync(page: 1, pageSize: 5000);
                if (leaves.Success && leaves.Value is not null)
                    foreach (var l in leaves.Value.Items)
                    {
                        sb.AppendLine(string.Join(",", new[] {
                            CsvEscape(l.EmployeeName), CsvEscape(l.LeaveTypeName),
                            l.StartDate.ToString("yyyy-MM-dd"), l.EndDate.ToString("yyyy-MM-dd"),
                            l.DaysRequested.ToString("F1"), l.Status.ToString(),
                            CsvEscape(l.Reason),
                            l.FiledAt.ToString("yyyy-MM-dd"),
                        }));
                        rowCount++;
                    }
                break;
            }
            case ReportCategory.Recruitment:
            {
                sb.AppendLine("Candidate,Email,Phone,Job,Stage,Source,Rating,Applied At");
                var candidates = await RecruitmentApi.ListCandidatesAsync();
                if (candidates.Success && candidates.Value is not null)
                    foreach (var c in candidates.Value)
                    {
                        sb.AppendLine(string.Join(",", new[] {
                            CsvEscape($"{c.FirstName} {c.LastName}"),
                            CsvEscape(c.Email), CsvEscape(c.Phone),
                            CsvEscape(c.JobTitle),
                            c.Stage.ToString(),
                            CsvEscape(c.Source),
                            c.Rating.ToString(),
                            c.AppliedAt.ToString("yyyy-MM-dd"),
                        }));
                        rowCount++;
                    }
                break;
            }
            case ReportCategory.Benefits:
            {
                sb.AppendLine("Employee,Program,Provider,Category,Status,Enrolled On,Monthly Contribution");
                var programsTask = BenefitsApi.ListProgramsAsync();
                var enrollmentsTask = BenefitsApi.ListEnrollmentsAsync();
                await Task.WhenAll(programsTask, enrollmentsTask);

                var programsById = (programsTask.Result.Success && programsTask.Result.Value is not null)
                    ? programsTask.Result.Value.ToDictionary(p => p.Id)
                    : new Dictionary<Guid, Giwu.Contracts.Benefits.BenefitProgramDto>();

                if (enrollmentsTask.Result.Success && enrollmentsTask.Result.Value is not null)
                    foreach (var en in enrollmentsTask.Result.Value)
                    {
                        programsById.TryGetValue(en.BenefitProgramId, out var prog);
                        sb.AppendLine(string.Join(",", new[] {
                            CsvEscape(en.EmployeeName),
                            CsvEscape(en.ProgramName),
                            CsvEscape(prog?.Provider ?? ""),
                            prog?.Category.ToString() ?? "",
                            en.Status.ToString(),
                            en.EnrolledOn.ToString("yyyy-MM-dd"),
                            en.MonthlyContribution.ToString("F2"),
                        }));
                        rowCount++;
                    }
                break;
            }
            default:
            {
                // Compliance/Custom or anything we don't have a row dataset for —
                // emit the API summary stats as a one-row CSV so the file is still meaningful.
                sb.AppendLine("Metric,Value");
                var hc = await ReportsApi.HeadcountAsync();
                if (hc.Success && hc.Value is not null)
                {
                    sb.AppendLine($"Total Employees,{hc.Value.TotalEmployees}");
                    sb.AppendLine($"Active,{hc.Value.Active}");
                    sb.AppendLine($"Departments,{hc.Value.Departments}");
                    rowCount += 3;
                }
                break;
            }
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        return new CsvPayload(sb.ToString(), rowCount, bytes.LongLength);
    }

    private async Task TriggerBlobDownloadAsync(byte[] content, string filename, string mimeType)
    {
        var base64 = Convert.ToBase64String(content);
        // Same Blob-download trick used by the Attendance page — works inside the
        // WebView2/Blazor Hybrid container without needing a server endpoint.
        await JS.InvokeVoidAsync("eval",
            $@"(function(){{var bin=atob('{base64}');var bytes=new Uint8Array(bin.length);for(var i=0;i<bin.length;i++)bytes[i]=bin.charCodeAt(i);var blob=new Blob([bytes],{{type:'{mimeType}'}});var url=URL.createObjectURL(blob);var a=document.createElement('a');a.href=url;a.download='{filename}';document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(url);}})();");
    }

    private static string CsvEscape(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        var needsQuoting = value.Contains(',') || value.Contains('"') || value.Contains('\n');
        var escaped = value.Replace("\"", "\"\"");
        return needsQuoting ? $"\"{escaped}\"" : escaped;
    }

    /// <summary>Renders the run's PeriodStart/PeriodEnd as "MMM d – MMM d, yyyy"
    /// for the PDF header. Returns null when the run isn't date-scoped so the
    /// PDF exporter can omit the Period row entirely.</summary>
    private static string? BuildPeriodText(ReportRun run)
    {
        if (!run.PeriodStart.HasValue || !run.PeriodEnd.HasValue) return null;
        var s = run.PeriodStart.Value;
        var e = run.PeriodEnd.Value;
        return s.Year == e.Year
            ? $"{s:MMM d} – {e:MMM d, yyyy}"
            : $"{s:MMM d, yyyy} – {e:MMM d, yyyy}";
    }

