                Source: cand.Source, Rating: cand.Rating, Notes: cand.Notes));
            if (apiResult.Success)
            {
                Snackbar.Add($"{cand.Name} updated", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to update candidate.", Severity.Error);
            }
        }
    }

    private async Task OpenScheduleInterviewDialog(string id)
    {
        var cand = Candidates.FirstOrDefault(c => c.Id == id);
        if (cand == null) return;
        if (!Guid.TryParse(cand.Id, out var candidateId)) { Snackbar.Add("Invalid candidate id", Severity.Error); return; }

