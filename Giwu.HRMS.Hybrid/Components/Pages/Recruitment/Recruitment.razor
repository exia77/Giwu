            {
                Snackbar.Add($"Interview scheduled with {cand.Name}", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to schedule interview.", Severity.Error);
            }
        }
    }

    private async Task OpenCreateJobDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditJobDialog>("Post New Role", new DialogParameters(), options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is JobRequisition j)
        {
            if (!_deptIdByName.TryGetValue(j.Dept, out var deptId))
            {
                Snackbar.Add($"Department '{j.Dept}' not found. Create it in Departments first.", Severity.Error);
                return;
            }
            var apiResult = await RecruitmentApi.CreateJobAsync(new CreateJobRequisitionRequest(
                Title: j.Title, DepartmentId: deptId, Location: j.Location,
                EmploymentType: j.EmploymentType, Openings: j.Openings,
                OwnerEmployeeId: null,
                SalaryMin: j.SalaryMin, SalaryMax: j.SalaryMax,
                TargetFillBy: j.TargetFillBy.HasValue ? DateOnly.FromDateTime(j.TargetFillBy.Value) : null,
                Description: j.Description,
                Status: JobStatusToEnum(j.Status)));
            if (apiResult.Success)
            {
                Snackbar.Add($"Role posted: {j.Title}", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to post role.", Severity.Error);
            }
        }
    }

    private async Task OpenEditJobDialog(string id)
    {
        var job = Jobs.FirstOrDefault(j => j.Id == id);
        if (job == null) return;
        if (!Guid.TryParse(job.Id, out var guid)) { Snackbar.Add("Invalid job id", Severity.Error); return; }

        var parameters = new DialogParameters { ["Existing"] = job };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditJobDialog>($"Edit — {job.Title}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            if (!_deptIdByName.TryGetValue(job.Dept, out var deptId))
            {
                Snackbar.Add($"Department '{job.Dept}' not found.", Severity.Error);
                return;
            }
            var apiResult = await RecruitmentApi.UpdateJobAsync(guid, new UpdateJobRequisitionRequest(
                Title: job.Title, DepartmentId: deptId, Location: job.Location,
                EmploymentType: job.EmploymentType, Openings: job.Openings, Filled: job.Filled,
                OwnerEmployeeId: null,
                SalaryMin: job.SalaryMin, SalaryMax: job.SalaryMax,
                TargetFillBy: job.TargetFillBy.HasValue ? DateOnly.FromDateTime(job.TargetFillBy.Value) : null,
                Description: job.Description));
            if (apiResult.Success)
            {
                Snackbar.Add($"{job.Title} updated", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to update job.", Severity.Error);
            }
        }
    }

    private async void ChangeJobStatus(string id, string newStatus)
    {
        if (!Guid.TryParse(id, out var guid)) { Snackbar.Add("Invalid job id", Severity.Error); return; }

        var apiResult = await RecruitmentApi.ChangeJobStatusAsync(guid,
            new ChangeJobStatusRequest(JobStatusToEnum(newStatus)));
        if (apiResult.Success)
        {
            var verb = newStatus switch { "Open" => "reopened", "On Hold" => "put on hold", "Closed" => "closed", _ => "updated" };
            var job = Jobs.FirstOrDefault(j => j.Id == id);
            Snackbar.Add($"{job?.Title ?? "Role"} {verb}", Severity.Info);
            await ReloadAsync();
        }
        else
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to change job status.", Severity.Error);
        }
    }

    private List<JobRequisition> Jobs { get; set; } = new();
    private List<Candidate> Candidates { get; set; } = new();
    private List<Interview> Interviews { get; set; } = new();

    private IReadOnlyList<DepartmentDto> _departments = Array.Empty<DepartmentDto>();
    private readonly Dictionary<string, Guid> _deptIdByName = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _deptNameById = new();

    private static readonly string[] AvatarTones = { "green", "blue", "amber", "purple", "primary", "red" };

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        var deptTask        = DepartmentsApi.ListAsync(includeInactive: true);
        var jobsTask        = RecruitmentApi.ListJobsAsync();
        var candidatesTask  = RecruitmentApi.ListCandidatesAsync();
        var interviewsTask  = RecruitmentApi.ListInterviewsAsync();

        await Task.WhenAll(deptTask, jobsTask, candidatesTask, interviewsTask);

        if (deptTask.Result is { Success: true, Value: { } depts })
        {
            _departments = depts;
            _deptIdByName.Clear();
            _deptNameById.Clear();
            foreach (var d in depts)
            {
                _deptIdByName[d.Name] = d.Id;
                _deptNameById[d.Id.ToString()] = d.Name;
            }
        }

        if (jobsTask.Result is { Success: true, Value: { } jobs })
            Jobs = jobs.Select(MapJob).ToList();
        else if (jobsTask.Result.ErrorMessage is { } jobErr)
            Snackbar.Add(jobErr, Severity.Error);

        if (candidatesTask.Result is { Success: true, Value: { } cands })
            Candidates = cands.Select(MapCandidate).ToList();
        else if (candidatesTask.Result.ErrorMessage is { } candErr)
            Snackbar.Add(candErr, Severity.Error);

        if (interviewsTask.Result is { Success: true, Value: { } ivs })
            Interviews = ivs.Select(MapInterview).ToList();
        else if (interviewsTask.Result.ErrorMessage is { } ivErr)
            Snackbar.Add(ivErr, Severity.Error);

        StateHasChanged();
    }

    // ── DTO ↔ UI mapping ────────────────────────────────────────────────────
    private static JobRequisition MapJob(JobRequisitionDto d)
    {
        var ownerInit = MakeInitials(d.OwnerName);
        var ownerAv   = AvatarTones[Math.Abs(d.Id.GetHashCode()) % AvatarTones.Length];
        return new JobRequisition
        {
            Id = d.Id.ToString(),
            Title = d.Title,
            Dept = d.DepartmentName,
            Location = d.Location,
            EmploymentType = d.EmploymentType,
            Openings = d.Openings,
            Filled = d.Filled,
            Status = JobStatusFromEnum(d.Status),
            Owner = string.IsNullOrEmpty(ownerInit) ? "—" : ownerInit,
            OwnerAv = ownerAv,
            SalaryMin = d.SalaryMin,
            SalaryMax = d.SalaryMax,
            PostedOn = d.PostedAt.LocalDateTime,
            TargetFillBy = d.TargetFillBy?.ToDateTime(TimeOnly.MinValue),
            Description = d.Description,
        };
    }

    private static Candidate MapCandidate(CandidateDto d) => new()
    {
        Id = d.Id.ToString(),
        Name = $"{d.FirstName} {d.LastName}".Trim(),
        Init = MakeInitials($"{d.FirstName} {d.LastName}"),
        Av = AvatarTones[Math.Abs(d.Id.GetHashCode()) % AvatarTones.Length],
        Email = d.Email,
        Phone = d.Phone,
        JobId = d.JobRequisitionId.ToString(),
        Stage = d.Stage.ToString(),
        Source = d.Source,
        AppliedOn = d.AppliedAt.LocalDateTime,
        LastActivity = d.LastActivityAt.LocalDateTime,
        Rating = d.Rating,
        Notes = d.Notes,
    };

    private static Interview MapInterview(InterviewDto d)
    {
        var name = d.InterviewerName ?? "";
        return new Interview
        {
            Id = d.Id.ToString(),
            CandidateId = d.CandidateId.ToString(),
            ScheduledAt = d.ScheduledAt.LocalDateTime,
            DurationMinutes = d.DurationMinutes,
            Kind = InterviewKindFromEnum(d.Kind),
            Interviewer = name,
            InterviewerInit = MakeInitials(name),
            InterviewerAv = AvatarTones[Math.Abs(d.Id.GetHashCode()) % AvatarTones.Length],
            Location = d.Location,
            Status = d.Status.ToString(),
        };
    }

    private static string MakeInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant(),
        };
    }

    private static (string First, string Last) SplitName(string fullName)
    {
        var parts = (fullName ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => ("", ""),
            1 => (parts[0], ""),
            _ => (parts[0], string.Join(' ', parts[1..])),
        };
    }

    private static string JobStatusFromEnum(DomainRec.JobStatus s) => s switch
    {
        DomainRec.JobStatus.Open => "Open",
        DomainRec.JobStatus.OnHold => "On Hold",
        DomainRec.JobStatus.Closed => "Closed",
        DomainRec.JobStatus.Draft => "Draft",
        _ => s.ToString(),
    };

    private static DomainRec.JobStatus JobStatusToEnum(string s) => s switch
    {
        "Open" => DomainRec.JobStatus.Open,
        "On Hold" => DomainRec.JobStatus.OnHold,
        "Closed" => DomainRec.JobStatus.Closed,
        "Draft" => DomainRec.JobStatus.Draft,
        _ => DomainRec.JobStatus.Draft,
    };

    private static DomainRec.CandidateStage StageToEnum(string s) =>
        Enum.TryParse<DomainRec.CandidateStage>(s, out var v) ? v : DomainRec.CandidateStage.Applied;

    private static string InterviewKindFromEnum(DomainRec.InterviewKind k) => k switch
    {
        DomainRec.InterviewKind.PhoneScreen => "Phone Screen",
        DomainRec.InterviewKind.Technical   => "Technical",
        DomainRec.InterviewKind.Panel       => "Panel",
        DomainRec.InterviewKind.Final       => "Final",
        _ => "Other",
    };

    private static DomainRec.InterviewKind InterviewKindToEnum(string s) => s switch
    {
        "Phone Screen" => DomainRec.InterviewKind.PhoneScreen,
        "Technical"    => DomainRec.InterviewKind.Technical,
        "Panel"        => DomainRec.InterviewKind.Panel,
        "Final"        => DomainRec.InterviewKind.Final,
        _              => DomainRec.InterviewKind.Other,
    };
}
