@page "/recruitment"
@using static Giwu.HRMS.Hybrid.Models.RecruitmentFormatting
@using Giwu.Contracts.Departments
@using Giwu.Contracts.Recruitment
@using Giwu.HRMS.Hybrid.Services.Departments
@using Giwu.HRMS.Hybrid.Services.Recruitment
@using DomainRec = Giwu.Domain.Recruitment
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IRecruitmentApi RecruitmentApi
@inject IDepartmentsApi DepartmentsApi

@using Pages.Recruitment.Components

<RoleGuard NavKey="@NavKeys.Recruitment" />

<PageTitle>Recruitment</PageTitle>

@* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   KPI STRIP
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="rec-kpi" Elevation="0">
            <div class="kpi-label">Open Roles</div>
            <div class="kpi-value">@OpenRolesCount</div>
            <div class="kpi-sub">
                <span class="kpi-dot" style="background:var(--rec-green)"></span>
                <span>@TotalOpeningsCount openings total</span>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="rec-kpi" Elevation="0">
            <div class="kpi-label">Active Candidates</div>
            <div class="kpi-value">@ActiveCandidateCount</div>
            <div class="kpi-sub">
                <span class="kpi-dot" style="background:var(--rec-blue)"></span>
                <span>@NewThisWeek new this week</span>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="rec-kpi" Elevation="0">
            <div class="kpi-label">Interviews This Week</div>
            <div class="kpi-value">@InterviewsThisWeekCount</div>
            <div class="kpi-sub">
                <span class="kpi-dot" style="background:var(--rec-amber)"></span>
                <span>@UpcomingInterviewCount upcoming</span>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="rec-kpi" Elevation="0">
            <div class="kpi-label">Offers Pending</div>
            <div class="kpi-value">@OffersCount</div>
            <div class="kpi-sub">
                <span class="kpi-dot" style="background:var(--rec-purple)"></span>
                <span>avg 18 days to hire</span>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   FUNNEL + UPCOMING INTERVIEWS
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" md="7">
        <MudPaper Class="rec-card" Elevation="0">
            <div class="rec-card-header">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="fw-medium">Pipeline Funnel</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.55">Candidates by current stage</MudText>
                </div>
                <MudSelect T="string" @bind-Value="FunnelJobFilter" Dense="true" Variant="Variant.Outlined"
                           Style="width:200px" Margin="Margin.Dense" Clearable="true">
                    <MudSelectItem Value="@("")">All roles</MudSelectItem>
                    @foreach (var j in Jobs.Where(j => j.Status == "Open"))
                    {
                        <MudSelectItem Value="@j.Id">@j.Title</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="funnel-wrap">
                @{
                    var funnelMax = PipelineStages.Max(s => CountByStage(s, FunnelJobFilter));
                    if (funnelMax == 0) funnelMax = 1;
                }
                @foreach (var stage in PipelineStages)
                {
                    var count = CountByStage(stage, FunnelJobFilter);
                    var pct = (int)Math.Round(count / (double)funnelMax * 100);
                    <div class="funnel-row">
                        <div class="funnel-label">
                            <span class="@($"rec-badge {StageBadgeClass(stage)}")">@stage</span>
                        </div>
                        <div class="funnel-track">
                            <div class="funnel-fill" style="@($"width:{pct}%;background:{StageColor(stage)}")"></div>
                        </div>
                        <div class="funnel-count">@count</div>
                    </div>
                }
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudPaper Class="rec-card" Elevation="0">
            <div class="rec-card-header">
                <MudText Typo="Typo.subtitle2" Class="fw-medium">Upcoming Interviews</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="height:20px;font-size:.7rem">
                    Next 7 days
                </MudChip>
            </div>
            @if (UpcomingInterviews.Count == 0)
            {
                <div class="rec-empty">
                    <div class="rec-empty-icon">â€”</div>
                    <MudText Typo="Typo.body2">No interviews scheduled.</MudText>
                </div>
            }
            else
            {
                @foreach (var iv in UpcomingInterviews.Take(4))
                {
                    var cand = Candidates.FirstOrDefault(c => c.Id == iv.CandidateId);
                    if (cand == null) continue;
                    var job = Jobs.FirstOrDefault(j => j.Id == cand.JobId);
                    <div class="interview-item">
                        <div class="interview-date">
                            <div class="interview-day">@iv.ScheduledAt.ToString("ddd").ToUpper()</div>
                            <div class="interview-num">@iv.ScheduledAt.Day</div>
                        </div>
                        <div class="interview-meta">
                            <MudText Typo="Typo.body2" Class="fw-medium">@cand.Name</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:.55">
                                @iv.Kind Â· @iv.ScheduledAt.ToString("h:mm tt") Â· @(job?.Title ?? "â€”")
                            </MudText>
                        </div>
                        <MudAvatar Style="@AvatarStyle(iv.InterviewerAv)" Class="rec-av-sm"
                                   Title="@iv.Interviewer">@iv.InterviewerInit</MudAvatar>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   MAIN TABS: CANDIDATES / JOBS
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
<MudPaper Class="rec-card" Elevation="0">
    <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
             PanelClass="rec-tab-panel" TabPanelClass="rec-tab-item"
             @bind-ActivePanelIndex="ActiveTab">

        @* â•â• CANDIDATES TAB â•â• *@
        <MudTabPanel Text="@($"Candidates ({Candidates.Count(c => c.Stage != "Rejected")})")"
                     Icon="@Icons.Material.Outlined.PeopleAlt">
            <div class="rec-card-header">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="fw-medium">All Candidates</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.55">
                        @FilteredCandidates.Count() of @Candidates.Count shown
                    </MudText>
                </div>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.FilterList"
                               OnClick="ToggleAdvancedFilters">
                        @(ShowAdvancedFilters ? "Hide Filters" : "Filters")
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.PersonAdd" DisableElevation="true"
                               OnClick="OpenAddCandidateDialog">Add Candidate</MudButton>
                </MudStack>
            </div>

            <div class="filter-row">
                <MudChipSet T="string" @bind-SelectedValue="CandidateStageFilter" CheckMark="false" Mandatory="true">
                    <MudChip T="string" Value="@("All")" Size="Size.Small">All</MudChip>
                    <MudChip T="string" Value="@("Applied")" Size="Size.Small">Applied</MudChip>
                    <MudChip T="string" Value="@("Screening")" Size="Size.Small">Screening</MudChip>
                    <MudChip T="string" Value="@("Interview")" Size="Size.Small">Interview</MudChip>
                    <MudChip T="string" Value="@("Offer")" Size="Size.Small">Offer</MudChip>
                    <MudChip T="string" Value="@("Hired")" Size="Size.Small">Hired</MudChip>
                    <MudChip T="string" Value="@("Rejected")" Size="Size.Small">Rejected</MudChip>
                </MudChipSet>
                <MudSpacer />
                <MudTextField @bind-Value="CandidateSearch" Placeholder="Search name, emailâ€¦"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="rec-search"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              DebounceInterval="200" Immediate="true" />
            </div>

            @if (ShowAdvancedFilters)
            {
                <div class="filter-row" style="border-top:none;padding-top:0">
                    <MudSelect T="string" @bind-Value="CandidateJobFilter" Placeholder="Role" Dense="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:180px" Clearable="true">
                        <MudSelectItem Value="@("")">All roles</MudSelectItem>
                        @foreach (var j in Jobs)
                        {
                            <MudSelectItem Value="@j.Id">@j.Title</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="CandidateSourceFilter" Placeholder="Source" Dense="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" Clearable="true">
                        <MudSelectItem Value="@("")">All sources</MudSelectItem>
                        <MudSelectItem Value="@("LinkedIn")">LinkedIn</MudSelectItem>
                        <MudSelectItem Value="@("Referral")">Referral</MudSelectItem>
                        <MudSelectItem Value="@("Job Board")">Job Board</MudSelectItem>
                        <MudSelectItem Value="@("Website")">Website</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="int" @bind-Value="CandidateMinRating" Placeholder="Min rating" Dense="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:130px">
                        <MudSelectItem Value="0">Any</MudSelectItem>
                        <MudSelectItem Value="3">â‰¥ 3 â˜…</MudSelectItem>
                        <MudSelectItem Value="4">â‰¥ 4 â˜…</MudSelectItem>
                        <MudSelectItem Value="5">5 â˜… only</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearAdvancedFilters">Clear</MudButton>
                </div>
            }

            <MudTable T="Candidate" Items="@FilteredCandidates" Dense="true" Hover="true"
                      Elevation="0" Breakpoint="Breakpoint.Sm"
                      @bind-RowsPerPage="CandidatePageSize" @bind-Page="CandidatePage"
                      Class="rec-mud-table">
                <HeaderContent>
                    <MudTh><MudTableSortLabel T="Candidate" SortBy="@(c => c.Name)">Candidate</MudTableSortLabel></MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh><MudTableSortLabel T="Candidate" SortBy="@(c => c.Stage)">Stage</MudTableSortLabel></MudTh>
                    <MudTh>Source</MudTh>
                    <MudTh><MudTableSortLabel T="Candidate" SortBy="@(c => c.Rating)">Rating</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="Candidate" SortBy="@(c => c.LastActivity)">Last Activity</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Candidate">
                        <div style="display:flex;align-items:center;gap:9px">
                            <MudAvatar Style="@AvatarStyle(context.Av)" Class="rec-av-sm">@context.Init</MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2" Class="fw-medium" Style="line-height:1.2">@context.Name</MudText>
                                <MudText Typo="Typo.caption" Style="opacity:.55">@context.Email</MudText>
                            </div>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Role" Style="opacity:.8">
                        @(Jobs.FirstOrDefault(j => j.Id == context.JobId)?.Title ?? "â€”")
                    </MudTd>
                    <MudTd DataLabel="Stage">
                        <span class="@($"rec-badge {StageBadgeClass(context.Stage)}")">@context.Stage</span>
                    </MudTd>
                    <MudTd DataLabel="Source" Style="opacity:.7;font-size:12px">@context.Source</MudTd>
                    <MudTd DataLabel="Rating">@StarRating(context.Rating)</MudTd>
                    <MudTd DataLabel="Last Activity" Style="opacity:.7;font-size:12px">
                        @RelativeTime(context.LastActivity)
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            @if (context.Stage != "Hired" && context.Stage != "Rejected")
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                           OnClick="@(() => OpenAdvanceDialog(context.Id))">
                                    Advance
                                </MudButton>
                            }
                            <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small"
                                           OnClick="@(() => OpenCandidateDetailDialog(context.Id))" />
                            <MudMenu Icon="@Icons.Material.Outlined.MoreVert" Size="Size.Small" Dense="true">
                                <MudMenuItem Icon="@Icons.Material.Outlined.Event"
                                             OnClick="@(() => OpenScheduleInterviewDialog(context.Id))">
                                    Schedule interview
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Outlined.Edit"
                                             OnClick="@(() => OpenEditCandidateDialog(context.Id))">
                                    Edit candidate
                                </MudMenuItem>
                                @if (context.Stage != "Rejected" && context.Stage != "Hired")
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Block"
                                                 OnClick="@(() => OpenRejectDialog(context.Id))">
                                        Reject
                                    </MudMenuItem>
                                }
                            </MudMenu>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="rec-empty">
                        <div class="rec-empty-icon">âŠ˜</div>
                        <MudText Typo="Typo.body2">No candidates match your filters.</MudText>
                    </div>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50 }" />
                </PagerContent>
            </MudTable>
        </MudTabPanel>

        @* â•â• JOBS TAB â•â• *@
        <MudTabPanel Text="@($"Jobs ({Jobs.Count(j => j.Status == "Open")} open)")"
                     Icon="@Icons.Material.Outlined.WorkOutline">
            <div class="rec-card-header">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="fw-medium">Open Requisitions</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.55">@FilteredJobs.Count() of @Jobs.Count roles</MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Add" DisableElevation="true"
                           OnClick="OpenCreateJobDialog">Post New Role</MudButton>
            </div>
            <div class="filter-row">
                <MudChipSet T="string" @bind-SelectedValue="JobStatusFilter" CheckMark="false" Mandatory="true">
                    <MudChip T="string" Value="@("All")" Size="Size.Small">All</MudChip>
                    <MudChip T="string" Value="@("Open")" Size="Size.Small">Open</MudChip>
                    <MudChip T="string" Value="@("On Hold")" Size="Size.Small">On Hold</MudChip>
                    <MudChip T="string" Value="@("Closed")" Size="Size.Small">Closed</MudChip>
                    <MudChip T="string" Value="@("Draft")" Size="Size.Small">Draft</MudChip>
                </MudChipSet>
                <MudSpacer />
                <MudTextField @bind-Value="JobSearch" Placeholder="Search title, deptâ€¦"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="rec-search"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              DebounceInterval="200" Immediate="true" />
            </div>

            <MudTable T="JobRequisition" Items="@FilteredJobs" Dense="true" Hover="true"
                      Elevation="0" Breakpoint="Breakpoint.Sm"
                      @bind-RowsPerPage="JobPageSize" @bind-Page="JobPage"
                      Class="rec-mud-table">
                <HeaderContent>
                    <MudTh><MudTableSortLabel T="JobRequisition" SortBy="@(j => j.Title)">Role</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="JobRequisition" SortBy="@(j => j.Dept)">Department</MudTableSortLabel></MudTh>
                    <MudTh>Location</MudTh>
                    <MudTh>Progress</MudTh>
                    <MudTh>Candidates</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Owner</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Role">
                        <div>
                            <MudText Typo="Typo.body2" Class="fw-medium" Style="line-height:1.2">@context.Title</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:.55">
                                @context.EmploymentType Â· @FmtSalary(context.SalaryMin, context.SalaryMax)
                            </MudText>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Department" Style="opacity:.8">@context.Dept</MudTd>
                    <MudTd DataLabel="Location" Style="opacity:.7;font-size:12px">@context.Location</MudTd>
                    <MudTd DataLabel="Progress">
                        @{
                            var prog = context.Openings == 0 ? 0
                                : (int)Math.Round(context.Filled / (double)context.Openings * 100);
                        }
                        <div class="progress-wrap">
                            <div class="progress-bar"><div class="progress-fill" style="@($"width:{prog}%")"></div></div>
                            <span style="font-size:11px;opacity:.7">@context.Filled / @context.Openings</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Candidates">
                        @{
                            var pipeline = Candidates.Count(c => c.JobId == context.Id
                                && c.Stage != "Rejected" && c.Stage != "Hired");
                        }
                        <span style="font-size:12px">@pipeline active</span>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <span class="@($"rec-badge {JobStatusBadgeClass(context.Status)}")">@context.Status</span>
                    </MudTd>
                    <MudTd DataLabel="Owner">
                        <MudAvatar Style="@AvatarStyle(context.OwnerAv)" Class="rec-av-sm"
                                   Title="@context.Owner">@context.Owner</MudAvatar>
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                           OnClick="@(() => OpenEditJobDialog(context.Id))" />
                            <MudMenu Icon="@Icons.Material.Outlined.MoreVert" Size="Size.Small" Dense="true">
                                @if (context.Status == "Open")
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.PauseCircle"
                                                 OnClick="@(() => ChangeJobStatus(context.Id, "On Hold"))">
                                        Put on hold
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Outlined.CheckCircle"
                                                 OnClick="@(() => ChangeJobStatus(context.Id, "Closed"))">
                                        Close role
                                    </MudMenuItem>
                                }
                                else if (context.Status == "On Hold" || context.Status == "Draft")
                                {
                                    <MudMenuItem Icon="@Icons.Material.Outlined.PlayCircle"
                                                 OnClick="@(() => ChangeJobStatus(context.Id, "Open"))">
                                        Reopen
                                    </MudMenuItem>
                                }
                            </MudMenu>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="rec-empty">
                        <div class="rec-empty-icon">âŠ˜</div>
                        <MudText Typo="Typo.body2">No roles match your filters.</MudText>
                    </div>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 5, 10, 25 }" />
                </PagerContent>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   STYLES
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
<style>
    :root {
        --rec-green:        #1D9E75;
        --rec-green-light:  #E1F5EE;
        --rec-green-dark:   #0F6E56;
        --rec-green-text:   #085041;
        --rec-red:          #E24B4A;
        --rec-red-light:    #FCEBEB;
        --rec-red-text:     #791F1F;
        --rec-amber:        #BA7517;
        --rec-amber-light:  #FAEEDA;
        --rec-amber-text:   #633806;
        --rec-purple:       #534AB7;
        --rec-purple-light: #EEEDFE;
        --rec-purple-text:  #3C3489;
        --rec-blue:         #185FA5;
        --rec-blue-light:   #E6F1FB;
