    /* â”€â”€ MudTable overrides â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .rec-mud-table .mud-table-container { border-radius: 0; }
    .rec-mud-table th { font-size: 10.5px !important; font-weight: 500 !important; letter-spacing: .055em !important; text-transform: uppercase !important; opacity: .65; }
    .rec-mud-table td { font-size: 13px !important; vertical-align: middle; }

    /* â”€â”€ Responsive â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    @@media (max-width: 600px) {
        .rec-search { max-width: 100%; width: 100%; }
        .funnel-label { width: 80px; }
    }
</style>

@code {
    // â”€â”€â”€ State â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private int ActiveTab { get; set; } = 0;
    private string FunnelJobFilter { get; set; } = "";

    // Candidates tab state
    private string CandidateStageFilter { get; set; } = "All";
    private string CandidateSearch { get; set; } = "";
    private string CandidateJobFilter { get; set; } = "";
    private string CandidateSourceFilter { get; set; } = "";
    private int CandidateMinRating { get; set; } = 0;
    private bool ShowAdvancedFilters { get; set; } = false;
    private int CandidatePage { get; set; } = 0;
    private int CandidatePageSize { get; set; } = 10;

    // Jobs tab state
    private string JobStatusFilter { get; set; } = "All";
    private string JobSearch { get; set; } = "";
    private int JobPage { get; set; } = 0;
    private int JobPageSize { get; set; } = 10;

    // â”€â”€â”€ Derived â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private int OpenRolesCount => Jobs.Count(j => j.Status == "Open");
    private int TotalOpeningsCount => Jobs.Where(j => j.Status == "Open").Sum(j => j.Openings);
    private int ActiveCandidateCount => Candidates.Count(c => c.Stage != "Rejected" && c.Stage != "Hired");
    private int NewThisWeek => Candidates.Count(c => c.AppliedOn >= DateTime.Now.AddDays(-7));
    private int InterviewsThisWeekCount
    {
        get
        {
            // Week = Sunday..Saturday. DayOfWeek: Sunday=0, Saturday=6
            var today = DateTime.Today;
            var startOfWeek = today.AddDays(-(int)today.DayOfWeek);
            var endOfWeek = startOfWeek.AddDays(7);
            return Interviews.Count(i => i.ScheduledAt >= startOfWeek && i.ScheduledAt < endOfWeek);
        }
    }
    private int UpcomingInterviewCount => Interviews.Count(i => i.ScheduledAt >= DateTime.Now && i.Status == "Scheduled");
    private int OffersCount => Candidates.Count(c => c.Stage == "Offer");

    private List<Interview> UpcomingInterviews => Interviews
        .Where(i => i.ScheduledAt >= DateTime.Now && i.Status == "Scheduled")
        .OrderBy(i => i.ScheduledAt)
        .ToList();

    private int CountByStage(string stage, string jobFilter)
    {
        return Candidates.Count(c =>
            c.Stage == stage &&
            (string.IsNullOrEmpty(jobFilter) || c.JobId == jobFilter));
    }

    private IEnumerable<Candidate> FilteredCandidates
    {
        get
        {
            var q = (CandidateSearch ?? "").Trim().ToLower();
            return Candidates.Where(c =>
                (CandidateStageFilter == "All" || c.Stage == CandidateStageFilter) &&
                (string.IsNullOrEmpty(CandidateJobFilter) || c.JobId == CandidateJobFilter) &&
                (string.IsNullOrEmpty(CandidateSourceFilter) || c.Source == CandidateSourceFilter) &&
                (CandidateMinRating == 0 || c.Rating >= CandidateMinRating) &&
                (string.IsNullOrEmpty(q) || c.Name.ToLower().Contains(q) || c.Email.ToLower().Contains(q))
            );
        }
    }

    private IEnumerable<JobRequisition> FilteredJobs
    {
        get
        {
            var q = (JobSearch ?? "").Trim().ToLower();
            return Jobs.Where(j =>
                (JobStatusFilter == "All" || j.Status == JobStatusFilter) &&
                (string.IsNullOrEmpty(q) || j.Title.ToLower().Contains(q) || j.Dept.ToLower().Contains(q))
            );
        }
    }

    // â”€â”€â”€ Helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private string StageColor(string s) => s switch
    {
        "Applied"   => "var(--rec-blue)",
        "Screening" => "var(--rec-purple)",
        "Interview" => "var(--rec-amber)",
        "Offer"     => "var(--rec-green-dark)",
        "Hired"     => "var(--rec-green)",
        _           => "var(--mud-palette-divider)"
    };

    private RenderFragment StarRating(int r) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "rec-stars");
        builder.AddAttribute(2, "title", $"{r} / 5");
        for (int i = 1; i <= 5; i++)
        {
            // Unique sequence numbers per star slot: 10..14, 20..24, 30..34, 40..44, 50..54
            var baseSeq = i * 10;
            builder.OpenElement(baseSeq, "span");
            builder.AddAttribute(baseSeq + 1, "class", i <= r ? "rec-star-filled" : "rec-star-empty");
            builder.AddContent(baseSeq + 2, "â˜…");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private void ToggleAdvancedFilters() => ShowAdvancedFilters = !ShowAdvancedFilters;

    private void ClearAdvancedFilters()
    {
        CandidateJobFilter = "";
        CandidateSourceFilter = "";
        CandidateMinRating = 0;
    }

    // â”€â”€â”€ Actions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private async Task OpenCandidateDetailDialog(string id)
    {
        var cand = Candidates.FirstOrDefault(c => c.Id == id);
        if (cand == null) return;
        var job = Jobs.FirstOrDefault(j => j.Id == cand.JobId);
        var interviews = Interviews.Where(i => i.CandidateId == id).OrderBy(i => i.ScheduledAt).ToList();

        var parameters = new DialogParameters
        {
            ["Candidate"] = cand,
            ["Job"] = job,
            ["Interviews"] = interviews
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<CandidateDetailDialog>("Candidate Detail", parameters, options);
    }

    private async Task OpenAdvanceDialog(string id)
    {
        var cand = Candidates.FirstOrDefault(c => c.Id == id);
        if (cand == null) return;
        if (!Guid.TryParse(cand.Id, out var guid)) { Snackbar.Add("Invalid candidate id", Severity.Error); return; }

        var parameters = new DialogParameters { ["Candidate"] = cand };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AdvanceStageDialog>($"Advance {cand.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is StageChangeResult scr)
        {
            var apiResult = await RecruitmentApi.AdvanceCandidateAsync(guid,
                new AdvanceCandidateRequest(StageToEnum(scr.NewStage), scr.Note));
            if (apiResult.Success)
            {
                Snackbar.Add($"{cand.Name} advanced to {scr.NewStage}", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to advance candidate.", Severity.Error);
            }
        }
    }

    private async Task OpenRejectDialog(string id)
    {
        var cand = Candidates.FirstOrDefault(c => c.Id == id);
        if (cand == null) return;
        if (!Guid.TryParse(cand.Id, out var guid)) { Snackbar.Add("Invalid candidate id", Severity.Error); return; }

        var parameters = new DialogParameters { ["Candidate"] = cand };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RejectCandidateDialog>($"Reject {cand.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is string reason)
        {
            var apiResult = await RecruitmentApi.RejectCandidateAsync(guid, new RejectCandidateRequest(reason));
            if (apiResult.Success)
            {
                Snackbar.Add($"{cand.Name} rejected", Severity.Warning);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to reject candidate.", Severity.Error);
            }
        }
    }

    private async Task OpenAddCandidateDialog()
    {
        var parameters = new DialogParameters { ["Jobs"] = Jobs };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditCandidateDialog>("Add Candidate", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is Candidate c)
        {
            if (!Guid.TryParse(c.JobId, out var jobId))
            {
                Snackbar.Add("Pick a job for the candidate.", Severity.Error);
                return;
            }
            var (first, last) = SplitName(c.Name);
            var apiResult = await RecruitmentApi.CreateCandidateAsync(new CreateCandidateRequest(
                JobRequisitionId: jobId,
                FirstName: first, LastName: last,
                Email: c.Email, Phone: c.Phone,
                Source: c.Source, Rating: c.Rating, Notes: c.Notes));
            if (apiResult.Success)
            {
                Snackbar.Add($"{c.Name} added to pipeline", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to add candidate.", Severity.Error);
            }
        }
    }

    private async Task OpenEditCandidateDialog(string id)
    {
        var cand = Candidates.FirstOrDefault(c => c.Id == id);
