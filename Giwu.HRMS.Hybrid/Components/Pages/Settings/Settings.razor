            && a.Address == b.Address && a.City == b.City && a.Province == b.Province
            && a.PostalCode == b.PostalCode && a.Phone == b.Phone && a.Email == b.Email
            && a.Website == b.Website && a.Tin == b.Tin && a.RdoCode == b.RdoCode
            && a.SssEmployerNo == b.SssEmployerNo && a.PhilHealthEmployerNo == b.PhilHealthEmployerNo
