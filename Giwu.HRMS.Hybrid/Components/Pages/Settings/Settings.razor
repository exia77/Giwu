    private async Task OpenResetDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ResetSettingsDialog>("Reset Settings", new DialogParameters(), options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            SettingsService.ResetToDefaults();
            Theme.SetCompanyName("Giwu HR");
            Theme.SetLogo("");
            Theme.SetDark(false);
            ResetBrandingDrafts();
            ResetOrgDrafts();
            ResetLocaleDrafts();
            Snackbar.Add("All settings reset to defaults", Severity.Warning);
        }
    }

