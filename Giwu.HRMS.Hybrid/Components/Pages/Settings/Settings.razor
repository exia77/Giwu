    /// <summary>Maps the icon-name strings stored on IntegrationStatus to actual MudBlazor SVG path constants.</summary>
    private static string IntegrationIcon(string name) => name switch
    {
        "Fingerprint" => MudBlazor.Icons.Material.Outlined.Fingerprint,
        "Calculate"   => MudBlazor.Icons.Material.Outlined.Calculate,
        "Email"       => MudBlazor.Icons.Material.Outlined.Email,
        "Key"         => MudBlazor.Icons.Material.Outlined.Key,
        "CloudQueue"  => MudBlazor.Icons.Material.Outlined.CloudQueue,
        "Forum"       => MudBlazor.Icons.Material.Outlined.Forum,
        _             => MudBlazor.Icons.Material.Outlined.Extension
    };

    private static void CopyOrg(OrganizationProfile from, OrganizationProfile to)
    {
        to.LegalName = from.LegalName;
        to.TradeName = from.TradeName;
        to.Address = from.Address;
        to.City = from.City;
        to.Province = from.Province;
        to.PostalCode = from.PostalCode;
        to.Phone = from.Phone;
        to.Email = from.Email;
        to.Website = from.Website;
        to.Tin = from.Tin;
        to.RdoCode = from.RdoCode;
        to.SssEmployerNo = from.SssEmployerNo;
        to.PhilHealthEmployerNo = from.PhilHealthEmployerNo;
        to.PagibigEmployerNo = from.PagibigEmployerNo;
        to.DoleEstablishmentNo = from.DoleEstablishmentNo;
    }

    private static bool OrgEquals(OrganizationProfile a, OrganizationProfile b)
    {
        return a.LegalName == b.LegalName && a.TradeName == b.TradeName
            && a.Address == b.Address && a.City == b.City && a.Province == b.Province
            && a.PostalCode == b.PostalCode && a.Phone == b.Phone && a.Email == b.Email
            && a.Website == b.Website && a.Tin == b.Tin && a.RdoCode == b.RdoCode
            && a.SssEmployerNo == b.SssEmployerNo && a.PhilHealthEmployerNo == b.PhilHealthEmployerNo
            && a.PagibigEmployerNo == b.PagibigEmployerNo && a.DoleEstablishmentNo == b.DoleEstablishmentNo;
    }

    private static void CopyLocale(LocalizationSettings from, LocalizationSettings to)
    {
        to.Timezone = from.Timezone;
        to.DateFormat = from.DateFormat;
        to.CurrencyCode = from.CurrencyCode;
        to.CurrencySymbol = from.CurrencySymbol;
        to.WeekStart = from.WeekStart;
        to.FiscalYearStartMonth = from.FiscalYearStartMonth;
    }

    private static bool LocaleEquals(LocalizationSettings a, LocalizationSettings b)
    {
        return a.Timezone == b.Timezone && a.DateFormat == b.DateFormat
            && a.CurrencyCode == b.CurrencyCode && a.CurrencySymbol == b.CurrencySymbol
            && a.WeekStart == b.WeekStart && a.FiscalYearStartMonth == b.FiscalYearStartMonth;
    }
