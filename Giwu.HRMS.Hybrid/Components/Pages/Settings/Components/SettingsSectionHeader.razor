@* Reusable sticky header for each settings section. *@

<div class="settings-section-header">
    <div class="settings-section-meta">
        <div class="settings-section-title-row">
            <MudText Typo="Typo.h6" Class="fw-medium">@Title</MudText>
            @if (Dirty)
            {
                <span class="settings-dirty-pill">Unsaved changes</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(Description))
        {
            <MudText Typo="Typo.body2" Class="mt-1 giwu-text-muted">@Description</MudText>
        }
    </div>
    @if (OnSave.HasDelegate || OnReset.HasDelegate)
    {
        <div class="settings-section-actions">
            @if (OnReset.HasDelegate)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           Disabled="@(!Dirty)"
                           OnClick="OnReset">Reset</MudButton>
            }
            @if (OnSave.HasDelegate)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" DisableElevation="true" Size="Size.Small"
                           OnClick="OnSave">Save Changes</MudButton>
            }
        </div>
    }
</div>

<style>
    .settings-section-header {
        display: flex; justify-content: space-between; align-items: flex-start;
        gap: 16px; margin-bottom: 16px;
        flex-wrap: wrap;
    }
    .settings-section-meta { flex: 1; min-width: 0; }
    .settings-section-title-row {
        display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    }
    .settings-dirty-pill {
        font-size: 10px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase;
        padding: 2px 8px; border-radius: 100px;
        background: var(--set-amber-light, #FAEEDA);
        color: var(--set-amber-text, #633806);
    }
    .settings-section-actions {
        display: flex; gap: 8px; flex-shrink: 0;
    }
    .fw-medium { font-weight: 500; }
</style>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public bool Dirty { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
}
