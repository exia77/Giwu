@using Giwu.Contracts.Auth
@using Giwu.HRMS.Hybrid.Services.Auth
@inject IAuthApi AuthApi

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:600">Reset your password</MudText>
    </TitleContent>

    <DialogContent>
        @if (_done)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                If an account exists for that email, we just sent a reset link.
                Check your inbox (and spam folder).
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Style="opacity:.65;margin-bottom:14px">
                Enter the email associated with your account. We'll send a link
                you can use to set a new password.
            </MudText>

            <MudTextField @bind-Value="_email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="InputType.Email"
                          Required="true" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Filled" Class="mt-3">
                    @_error
                </MudAlert>
            }
        }
    </DialogContent>

    <DialogActions>
        @if (_done)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Style="text-transform:none;border-radius:8px"
                       OnClick="Close">Done</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" Style="text-transform:none" OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Style="text-transform:none;border-radius:8px"
                       OnClick="Submit"
                       Disabled="_busy || string.IsNullOrWhiteSpace(_email)">
                @(_busy ? "Sending…" : "Send reset link")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    string _email = "";
    bool _busy;
    bool _done;
    string? _error;

    async Task Submit()
    {
        _busy = true;
        _error = null;

        var result = await AuthApi.ForgotPasswordAsync(new ForgotPasswordRequest(_email.Trim()));
        _busy = false;

        if (result.Success) _done = true;
        else _error = result.ErrorMessage ?? "Could not send reset link";
    }

    void Close()  => MudDialog.Close(DialogResult.Ok(_email));
    void Cancel() => MudDialog.Cancel();
}
