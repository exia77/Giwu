@page "/reset-password"
@layout EmptyLayout
@using Giwu.Contracts.Auth
@using Giwu.HRMS.Hybrid.Services.Auth
@inject NavigationManager Navigation
@inject IAuthApi AuthApi

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px">
    <MudPaper Elevation="2" Style="max-width:440px;width:100%;padding:32px;border-radius:16px">
        <MudText Typo="Typo.h5" Style="font-weight:700;margin-bottom:8px">Set a new password</MudText>
        <MudText Typo="Typo.body2" Style="opacity:.65;margin-bottom:24px">
            Paste the reset token from your email and choose a new password.
        </MudText>

        @if (_done)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-3">
                Your password has been updated. You can now sign in with your new password.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Style="text-transform:none;border-radius:8px"
                       OnClick="GoToLogin">Go to login</MudButton>
        }
        else
        {
            <MudTextField @bind-Value="_email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="InputType.Email"
                          Class="mb-3"
                          Required="true" />

            <MudTextField @bind-Value="_token"
                          Label="Reset token"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3"
                          Required="true" />

            <MudTextField @bind-Value="_password"
                          Label="New password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="InputType.Password"
                          HelperText="Minimum 8 characters"
                          Class="mb-3"
                          Required="true" />

            <MudTextField @bind-Value="_confirm"
                          Label="Confirm new password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="InputType.Password"
                          Class="mb-3"
                          Required="true" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Filled" Class="mb-3">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Style="text-transform:none;border-radius:8px"
                       OnClick="Submit"
                       Disabled="_busy">
                @(_busy ? "Updating…" : "Update password")
            </MudButton>

            <MudButton Variant="Variant.Text" FullWidth="true" Class="mt-2"
                       Style="text-transform:none"
                       OnClick="GoToLogin">Back to login</MudButton>
        }
    </MudPaper>
</div>

@code {
    string _email = "";
    string _token = "";
    string _password = "";
    string _confirm = "";
    bool _busy;
    bool _done;
    string? _error;

    protected override void OnInitialized()
    {
        // Pre-fill from ?email=...&token=... if present (deep-link from email).
        var uri = new Uri(Navigation.Uri);
        var q = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _email = q["email"] ?? "";
        _token = q["token"] ?? "";
    }

    async Task Submit()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_token))
        {
            _error = "Email and reset token are required.";
            return;
        }

        if (_password.Length < 8)
        {
            _error = "Password must be at least 8 characters.";
            return;
        }

        if (_password != _confirm)
        {
            _error = "Passwords don't match.";
            return;
        }

        _busy = true;
        var result = await AuthApi.ResetPasswordAsync(new ResetPasswordRequest(_email.Trim(), _token.Trim(), _password));
        _busy = false;

        if (result.Success) _done = true;
        else _error = result.ErrorMessage ?? "Could not reset password";
    }

    void GoToLogin() => Navigation.NavigateTo("/login");
}
