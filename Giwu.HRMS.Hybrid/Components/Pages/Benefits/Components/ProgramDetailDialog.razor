@using static Giwu.HRMS.Hybrid.Models.BenefitsFormatting

<MudDialog>
    <DialogContent>
        @* Header *@
        <div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:16px">
            <div class="prog-detail-icon @(CategoryBadgeClass(Program.Category))">
                <MudIcon Icon="@CategoryIcon(Program.Category)" Size="Size.Medium" />
            </div>
            <div style="flex:1;min-width:0">
                <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
                    <MudText Typo="Typo.subtitle1" Class="fw-medium">@Program.Name</MudText>
                    @if (Program.IsMandatory)
                    {
                        <span class="ben-mandatory-chip">Mandatory</span>
                    }
                </div>
                <MudText Typo="Typo.caption" Class="giwu-text-muted">@Program.Provider</MudText>
            </div>
            <span class="@($"ben-badge {CategoryBadgeClass(Program.Category)}")">@CategoryLabel(Program.Category)</span>
        </div>

        @if (!string.IsNullOrEmpty(Program.Description))
        {
            <div class="prog-detail-desc">@Program.Description</div>
        }

        @* Quick stats *@
        <div class="prog-stat-grid">
            <div class="prog-stat">
                <div class="prog-stat-label">Enrolled</div>
                <div class="prog-stat-value">@EnrolledCount<span class="prog-stat-suffix"> / @TotalEmployees</span></div>
                <div class="prog-stat-bar">
                    <div class="prog-stat-bar-fill"
                         style="@($"width:{(TotalEmployees == 0 ? 0 : (int)Math.Round(EnrolledCount/(double)TotalEmployees*100))}%")"></div>
                </div>
            </div>
            <div class="prog-stat">
                <div class="prog-stat-label">Cost / Employee / Month</div>
                <div class="prog-stat-value">@Money(Program.MonthlyCostPerEmployee)</div>
                <div class="prog-stat-suffix">
                    Employer @Money(Program.EmployerShare) · Employee @Money(Program.EmployeeShare)
                </div>
            </div>
            <div class="prog-stat">
                <div class="prog-stat-label">Total Monthly Spend</div>
                <div class="prog-stat-value">@MoneyCompact(Program.MonthlyCostPerEmployee * EnrolledCount)</div>
                <div class="prog-stat-suffix">est. employer share</div>
            </div>
        </div>

        @* Details list *@
        <div class="prog-info">
            <div class="prog-info-row">
                <span class="prog-info-key">Eligibility</span>
                <span>@(string.IsNullOrEmpty(Program.Eligibility) ? "—" : Program.Eligibility)</span>
            </div>
            <div class="prog-info-row">
                <span class="prog-info-key">Effective date</span>
                <span>@FmtDate(Program.EffectiveDate)</span>
            </div>
            @if (Program.RenewalDate.HasValue)
            {
                var daysToRenewal = (Program.RenewalDate.Value - DateTime.Now).Days;
                <div class="prog-info-row">
                    <span class="prog-info-key">Renewal</span>
                    <span>
                        @FmtDate(Program.RenewalDate)
                        @if (daysToRenewal <= 60 && daysToRenewal > 0)
                        {
                            <span class="prog-renewal-warning">· in @daysToRenewal days</span>
                        }
                        else if (daysToRenewal <= 0)
                        {
                            <span class="prog-renewal-overdue">· overdue</span>
                        }
                    </span>
                </div>
            }
            <div class="prog-info-row">
                <span class="prog-info-key">Status</span>
                @if (Program.IsActive)
                {
                    <span class="ben-badge ben-badge-released">Active</span>
                }
                else
                {
                    <span class="ben-badge ben-badge-closed">Inactive</span>
                }
            </div>
        </div>

        @* Tiers *@
        @if (Program.Tiers.Count > 0)
        {
            <div class="prog-section-header">Coverage Tiers</div>
            <div class="prog-tiers">
                @foreach (var tier in Program.Tiers)
                {
                    <div class="prog-tier">
                        <div class="prog-tier-head">
                            <MudText Typo="Typo.body2" Class="fw-medium">@tier.Name</MudText>
                            <span class="prog-tier-cost">@Money(tier.MonthlyCost)/mo</span>
                        </div>
                        <div class="prog-tier-coverage">Coverage: @Money(tier.CoverageAmount)</div>
                        @if (!string.IsNullOrEmpty(tier.Inclusions))
                        {
                            <div class="prog-tier-inclusions">@tier.Inclusions</div>
                        }
                    </div>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .prog-detail-icon {
        width: 44px; height: 44px;
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .prog-detail-desc {
        background: var(--mud-palette-background-grey);
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 12.5px;
        line-height: 1.55;
        margin-bottom: 14px;
        opacity: .85;
    }
    .prog-stat-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-bottom: 14px;
    }
    .prog-stat {
        border: 1px solid var(--mud-palette-divider);
        border-radius: 8px;
        padding: 10px 12px;
    }
    .prog-stat-label {
        font-size: 10px;
        letter-spacing: .06em;
        text-transform: uppercase;
        opacity: .55;
        margin-bottom: 4px;
    }
    .prog-stat-value {
        font-size: 1.3rem;
        font-weight: 500;
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
    }
    .prog-stat-suffix {
        font-size: 10.5px;
        opacity: .6;
        margin-top: 3px;
        font-weight: 400;
    }
    .prog-stat-bar {
        height: 4px;
        background: var(--mud-palette-divider);
        border-radius: 2px;
        margin-top: 6px;
        overflow: hidden;
    }
    .prog-stat-bar-fill {
        height: 100%;
        background: var(--ben-green);
        border-radius: 2px;
    }

    .prog-info {
        border: 1px solid var(--mud-palette-divider);
        border-radius: 8px;
        margin-bottom: 12px;
        overflow: hidden;
    }
    .prog-info-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 12px;
        font-size: 13px;
        border-bottom: 1px solid var(--mud-palette-divider);
    }
    .prog-info-row:last-child { border-bottom: none; }
    .prog-info-key { opacity: .55; }
    .prog-renewal-warning { color: var(--ben-amber-text); font-weight: 500; }
    .prog-renewal-overdue { color: var(--ben-red-text); font-weight: 500; }

    .prog-section-header {
        font-size: 10.5px;
        letter-spacing: .06em;
        text-transform: uppercase;
        opacity: .55;
        font-weight: 500;
        margin-bottom: 8px;
        margin-top: 4px;
    }
    .prog-tiers {
        display: flex; flex-direction: column; gap: 8px;
    }
    .prog-tier {
        border: 1px solid var(--mud-palette-divider);
        border-radius: 8px;
        padding: 10px 12px;
    }
    .prog-tier-head {
        display: flex; justify-content: space-between; align-items: center;
    }
    .prog-tier-cost {
        font-size: 12px;
        font-weight: 500;
        color: var(--ben-green-text);
        font-variant-numeric: tabular-nums;
    }
    .prog-tier-coverage {
        font-size: 11.5px;
        opacity: .65;
        margin-top: 2px;
    }
    .prog-tier-inclusions {
        font-size: 11.5px;
        opacity: .8;
        margin-top: 6px;
        font-style: italic;
    }

    @@media (max-width: 600px) {
        .prog-stat-grid { grid-template-columns: 1fr; }
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public BenefitProgram Program { get; set; } = default!;
    [Parameter] public int EnrolledCount { get; set; }
    [Parameter] public int TotalEmployees { get; set; }

    private void Close() => MudDialog.Close();
}
