@page "/attendance"
@using static Giwu.HRMS.Hybrid.Models.AttendanceFormatting
@using Giwu.Contracts.Attendance
@using Giwu.Domain.Attendance
@using Giwu.HRMS.Hybrid.Services.Attendance
@using Giwu.HRMS.Hybrid.Services.Employees
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject IAttendanceApi AttendanceApi
@inject IEmployeesApi EmployeesApi
@inject Giwu.HRMS.Hybrid.Services.RoleAuthService RoleAuth
@inject Giwu.HRMS.Hybrid.Services.NavBadgeService NavBadges

@using Pages.Attendances.Components

<RoleGuard NavKey="@NavKeys.Attendance" />

<PageTitle>Attendance</PageTitle>

@*  KPI cards double as filter chips — click one to filter the table below. *@
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <StatCard Label="Present today" Value="@Counts.Present.ToString()"
                  Sub="@($"{PresentPct}% of workforce")"
                  Variant="StatTone.Success"
                  Active="@(CurrentFilter == "Present")"
                  OnClick="@(() => KpiFilter("Present"))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Label="Absent" Value="@Counts.Absent.ToString()"
                  Sub="@($"{UnexcusedCount} unexcused")"
                  Variant="StatTone.Danger"
                  Active="@(CurrentFilter == "Absent")"
                  OnClick="@(() => KpiFilter("Absent"))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Label="Late arrivals" Value="@Counts.Late.ToString()"
                  Sub="today"
                  Variant="StatTone.Warning"
                  Active="@(CurrentFilter == "Late")"
                  OnClick="@(() => KpiFilter("Late"))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Label="On leave" Value="@Counts.Leave.ToString()"
                  Sub="approved"
                  Variant="StatTone.Accent"
                  Active="@(CurrentFilter == "Leave")"
                  OnClick="@(() => KpiFilter("Leave"))" />
    </MudItem>
</MudGrid>

<div class="giwu-surface">
    @*  Toolbar is grouped by intent so 7 actions stay scannable:
          · Data actions (Refresh / Export / Analytics) collapsed to icons
          · Admin actions (Overtime / Add Entry) as text + outlined
          · Self-service (Clock In / Out) as the primary cluster on the right *@
    <PageHeader Title="@TableTitle"
                Subtitle="@($"{FilteredTotal} of {Employees.Count} records")"
                Tight="true">
        <Actions>
            <Toolbar>
                <ToolbarGroup>
                    <MudTooltip Text="Refresh data">
                        <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" OnClick="ReloadAsync" />
                    </MudTooltip>
                    <MudTooltip Text="Export to CSV">
                        <MudIconButton Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small" OnClick="ExportCsv" />
                    </MudTooltip>
                    <MudTooltip Text="Analytics">
                        <MudIconButton Icon="@Icons.Material.Outlined.QueryStats" Size="Size.Small" OnClick="OpenAnalyticsDialog" />
                    </MudTooltip>
                </ToolbarGroup>
                @* Admin actions: visible only to roles with attendance.manage
                    (HrAdmin). Manager/HrSpecialist have ViewAll but not Manage,
                    so submitting would 403. Always show the right-side
                    Clock In/Out cluster regardless. *@
                @if (RoleAuth.Can("attendance.manage"))
                {
                    <ToolbarDivider />
                    <ToolbarGroup>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.AccessTime"
                                   OnClick="OpenOvertimeDialog">Overtime</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.PersonAdd"
                                   OnClick="OpenManualEntryDialog">Add Entry</MudButton>
                    </ToolbarGroup>
                }
                <ToolbarDivider />
                <ToolbarGroup>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.Login" DisableElevation="true"
                               OnClick="ClockInSelf">Clock In</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.Logout"
                               OnClick="ClockOutSelf">Clock Out</MudButton>
                </ToolbarGroup>
            </Toolbar>
        </Actions>
    </PageHeader>

    <div class="filter-row">
        <MudChipSet T="string" @bind-SelectedValue="CurrentFilter" CheckMark="false" Mandatory="true">
            <MudChip T="string" Value="@("All")" Size="Size.Small">All</MudChip>
            <MudChip T="string" Value="@("Present")" Size="Size.Small">Present</MudChip>
            <MudChip T="string" Value="@("Absent")" Size="Size.Small">Absent</MudChip>
            <MudChip T="string" Value="@("Late")" Size="Size.Small">Late</MudChip>
            <MudChip T="string" Value="@("Leave")" Size="Size.Small">Leave</MudChip>
        </MudChipSet>
        <MudSpacer />
        <MudTextField @bind-Value="SearchText" Placeholder="Search name…"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="att-search"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      DebounceInterval="200" Immediate="true" />
    </div>

    @if (_loading)
    {
        <div class="giwu-p-4">
            <LoadingSkeleton Variant="LoadingSkeleton.Shape.List" Rows="6" />
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="giwu-p-4">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_loadError</MudAlert>
        </div>
    }
    else
    {
        <MudTable T="AttendanceEmployee" Items="@FilteredEmployees" Dense="true" Hover="true"
                  Elevation="0" Breakpoint="Breakpoint.Sm"
                  @bind-RowsPerPage="PageSize" @bind-Page="CurrentPage"
                  Class="att-mud-table">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="AttendanceEmployee" SortBy="@(e => e.Name)">Employee</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="AttendanceEmployee" SortBy="@(e => e.Dept)">Department</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="AttendanceEmployee" SortBy="@(e => e.Status)">Status</MudTableSortLabel></MudTh>
                <MudTh>Time In</MudTh>
                <MudTh>Time Out</MudTh>
                <MudTh>Hours</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Employee">
                    <div class="giwu-row-cell">
                        <MudAvatar Style="@AvatarStyle(context.Av)" Class="att-av-sm">@context.Init</MudAvatar>
                        <div>
                            <div class="giwu-fw-medium giwu-row-primary">@context.Name</div>
                            <div class="giwu-row-secondary">@context.Role</div>
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="Department" Class="giwu-text-muted">@context.Dept</MudTd>
                <MudTd DataLabel="Status">
                    <span class="giwu-pill @PillToneClass(context.Status)">@context.Status</span>
                </MudTd>
                <MudTd DataLabel="Time In">@FmtTime(context.Tin)</MudTd>
                <MudTd DataLabel="Time Out">@FmtTime(context.Tout)</MudTd>
                <MudTd DataLabel="Hours">
                    @{ var hw = HoursWorked(context.Tin, context.Tout); }
                    @if (hw.HasValue)
                    {
                        var pct = (int)Math.Round(Math.Min(hw.Value / 9.0 * 100, 100));
                        <div class="hours-wrap">
                            <div class="hours-bar"><div class="hours-fill" style="@($"width:{pct}%")"></div></div>
                            <span class="hours-text">@FmtHours(hw)</span>
                        </div>
                    }
                    else { <span class="giwu-text-faint">—</span> }
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align:right">
                    <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small"
                                   OnClick="@(() => OpenDetailDialog(context.Id))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Title="No records match your filter."
                            Hint="Try clearing filters or changing the date range."
                            Icon="@Icons.Material.Outlined.SearchOff" />
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50 }" />
            </PagerContent>
        </MudTable>
    }
</div>

<style>
    /* ─── Page-local styles only ───────────────────────────────────
       Cross-page primitives (kpi cards, surfaces, pills, toolbars,
       empty states) come from tokens.css + shared components.
       The legacy --att-* vars are retained because AttendanceFormatting.
       AvatarStyle still references them across dialogs we haven't
       migrated yet. Remove once all dialogs are on token-based pills. */
    :root {
        --att-green:#1D9E75;--att-green-light:#E1F5EE;--att-green-dark:#0F6E56;--att-green-text:#085041;
        --att-red:#E24B4A;--att-red-light:#FCEBEB;--att-red-text:#791F1F;
        --att-amber:#BA7517;--att-amber-light:#FAEEDA;--att-amber-text:#633806;
        --att-purple:#534AB7;--att-purple-light:#EEEDFE;--att-purple-text:#3C3489;
        --att-blue:#185FA5;--att-blue-light:#E6F1FB;--att-blue-text:#0C447C;
    }

    /* Legacy pills kept for AttendanceDetailDialog (not yet migrated).
       New code on this page uses .giwu-pill from tokens.css instead. */
    .att-badge { display:inline-block;font-size:var(--giwu-fs-xs);padding:3px 10px;border-radius:var(--giwu-radius-pill);font-weight:var(--giwu-fw-semibold);white-space:nowrap; }
    .badge-present { background:var(--giwu-status-success-bg);color:var(--giwu-status-success-fg); }
    .badge-absent  { background:var(--giwu-status-danger-bg); color:var(--giwu-status-danger-fg); }
    .badge-late    { background:var(--giwu-status-warning-bg);color:var(--giwu-status-warning-fg); }
    .badge-leave   { background:var(--giwu-status-accent-bg); color:var(--giwu-status-accent-fg); }
    .badge-wfh     { background:var(--giwu-status-info-bg);   color:var(--giwu-status-info-fg); }

    .att-av-sm { width:32px !important;height:32px !important;font-size:var(--giwu-fs-xs) !important;font-weight:var(--giwu-fw-medium); }

    /* Filter row inside the surface */
    .filter-row {
        display:flex; flex-wrap:wrap; align-items:center; gap:var(--giwu-space-2);
        padding:var(--giwu-space-3) var(--giwu-space-4);
        border-bottom:var(--giwu-border);
    }
    .att-search { max-width:280px; }
    @@media (max-width:600px) { .att-search { max-width:100%;width:100%; } }

    /* Row-cell helpers — also used by Dashboard once migrated. */
    .giwu-row-cell      { display:flex;align-items:center;gap:var(--giwu-space-2); }
    .giwu-row-primary   { line-height:1.2; }
    .giwu-row-secondary { font-size:var(--giwu-fs-sm);opacity:var(--giwu-opacity-muted); }

    /* Worked-hours mini bar */
    .hours-wrap { display:flex;align-items:center;gap:var(--giwu-space-2); }
    .hours-bar  { width:56px;height:5px;border-radius:3px;background:var(--mud-palette-divider);overflow:hidden;flex-shrink:0; }
    .hours-fill { height:100%;border-radius:3px;background:var(--giwu-status-success-solid); }
    .hours-text { font-size:var(--giwu-fs-xs);opacity:var(--giwu-opacity-muted); }

    /* MudTable density tweaks scoped to this page */
    .att-mud-table .mud-table-container { border-radius:0; }
    .att-mud-table .mud-table-toolbar   { padding:0;min-height:0; }
    .att-mud-table th {
        font-size:var(--giwu-fs-sm) !important;
        font-weight:var(--giwu-fw-semibold) !important;
        opacity:var(--giwu-opacity-muted) !important;
        text-transform:none !important;
        letter-spacing:0 !important;
    }
    .att-mud-table td { font-size:var(--giwu-fs-md) !important;vertical-align:middle;padding:var(--giwu-space-3) var(--giwu-space-4) !important; }
</style>

@code {
    private List<AttendanceEmployee> Employees { get; set; } = new();
    private bool _loading = true;
    private string? _loadError;

    private string CurrentFilter { get; set; } = "All";
    private string SearchText { get; set; } = "";
    private int CurrentPage { get; set; } = 0;
    private int PageSize { get; set; } = 10;
    private string TableTitle { get; set; } = "";

    private (int Present, int Absent, int Late, int Leave) Counts =>
        (Employees.Count(e => e.Status == "Present"),
         Employees.Count(e => e.Status == "Absent"),
         Employees.Count(e => e.Status == "Late"),
         Employees.Count(e => e.Status == "Leave"));

    private int PresentPct => Employees.Count == 0 ? 0 : (int)Math.Round(Counts.Present / (double)Employees.Count * 100);
    private int UnexcusedCount => Employees.Count(e => e.Status == "Absent");

    private IEnumerable<AttendanceEmployee> FilteredEmployees
    {
        get
        {
            var q = (SearchText ?? "").Trim().ToLower();
            return Employees.Where(e =>
                (CurrentFilter == "All" || e.Status == CurrentFilter) &&
                (string.IsNullOrEmpty(q)
                    || e.Name.ToLower().Contains(q)
                    || e.Dept.ToLower().Contains(q)
                    || e.Role.ToLower().Contains(q)));
        }
    }

    private int FilteredTotal => FilteredEmployees.Count();

    private void KpiFilter(string f) { CurrentFilter = f; CurrentPage = 0; }

    protected override async Task OnInitializedAsync()
    {
        TableTitle = $"Today's Attendance — {DateTime.Now:MMMM d, yyyy}";
        await ReloadAsync();
    }

    // Looked up once per reload to enrich attendance rows with Role + Dept.
    // AttendanceRecordDto only carries EmployeeName; everything else has to be
    // joined client-side against the Employees list.
    private Dictionary<Guid, (string Role, string Dept)> _empInfo = new();

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();

        var today = DateOnly.FromDateTime(DateTime.Today);

        // Fetch attendance + employees in parallel.
        var attTask = AttendanceApi.ListAsync(from: today, to: today, page: 1, pageSize: 200);
        var empTask = EmployeesApi.ListAsync(page: 1, pageSize: 500);
        await Task.WhenAll(attTask, empTask);
        _loading = false;

        if (!attTask.Result.Success || attTask.Result.Value is null)
        {
            _loadError = attTask.Result.ErrorMessage ?? "Failed to load attendance";
            return;
        }

        _empInfo = empTask.Result.Success && empTask.Result.Value is not null
            ? empTask.Result.Value.Items.ToDictionary(
                e => e.Id,
                e => (Role: e.JobTitle ?? "", Dept: e.DepartmentName ?? ""))
            : new();

        Employees = attTask.Result.Value.Items.Select(MapToUi).ToList();
    }

    private AttendanceEmployee MapToUi(AttendanceRecordDto dto)
    {
        var (role, dept) = _empInfo.TryGetValue(dto.EmployeeId, out var info)
            ? info
            : ("", "");
        return new AttendanceEmployee
        {
            Id = dto.Id.ToString(),
            Name = dto.EmployeeName,
            Init = MakeInitials(dto.EmployeeName),
            Av = AvatarTone(dto.EmployeeId),
            Role = role,
            Dept = dept,
            Status = StatusToLabel(dto.Status),
            Tin = dto.ClockIn?.LocalDateTime.ToString("HH:mm") ?? "",
            Tout = dto.ClockOut?.LocalDateTime.ToString("HH:mm") ?? "",
            Reason = dto.Notes ?? "",
            Pending = false,
        };
    }

    private static string MakeInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "·";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "·",
            1 => parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant(),
        };
    }

    private static readonly string[] _avTones = { "green", "blue", "amber", "purple", "primary" };
    private static string AvatarTone(Guid id) => _avTones[Math.Abs(id.GetHashCode()) % _avTones.Length];

    private static string StatusToLabel(AttendanceStatus s) => s switch
    {
        AttendanceStatus.Present   => "Present",
        AttendanceStatus.Late      => "Late",
        AttendanceStatus.Absent    => "Absent",
        AttendanceStatus.OnLeave   => "Leave",
        AttendanceStatus.Holiday   => "Holiday",
        AttendanceStatus.RestDay   => "Rest Day",
        AttendanceStatus.Suspended => "Suspended",
        _ => s.ToString(),
    };

    private async Task ClockInSelf()
    {
        var result = await AttendanceApi.ClockInAsync(new ClockInRequest(Source: "App", Location: ""));
        if (result.Success)
        {
            Snackbar.Add("Clocked in successfully.", Severity.Success);
            await ReloadAsync();
            await NavBadges.RequestRefreshAsync();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Failed to clock in.", Severity.Error);
        }
    }

    private async Task ClockOutSelf()
    {
        var result = await AttendanceApi.ClockOutAsync(new ClockOutRequest(Source: "App", Location: ""));
        if (result.Success)
        {
            Snackbar.Add("Clocked out successfully.", Severity.Success);
            await ReloadAsync();
            await NavBadges.RequestRefreshAsync();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Failed to clock out.", Severity.Error);
        }
    }

    private async Task OpenDetailDialog(string id)
    {
        var emp = Employees.FirstOrDefault(e => e.Id == id);
        if (emp == null) return;

        var parameters = new DialogParameters
        {
            ["Emp"] = emp,
            ["OnEdit"] = EventCallback.Factory.Create(this, () => OpenEditDialog(emp))
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<AttendanceDetailDialog>("Attendance Detail", parameters, options);
    }

    private async Task OpenEditDialog(AttendanceEmployee emp)
    {
        var parameters = new DialogParameters { ["Emp"] = emp };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditAttendanceDialog>($"Edit {emp.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        if (!Guid.TryParse(emp.Id, out var recordId))
        {
            Snackbar.Add("Cannot save: invalid attendance record id.", Severity.Error);
            return;
        }

        var req = new UpdateAttendanceRequest(
            Status:        ParseAttendanceStatus(emp.Status),
            ClockInTime:   ParseTime(emp.Tin),
            ClockOutTime:  ParseTime(emp.Tout),
            Notes:         emp.Reason ?? "");

        var apiResult = await AttendanceApi.UpdateAsync(recordId, req);
        if (apiResult.Success)
        {
            Snackbar.Add($"{emp.Name}'s record updated.", Severity.Success);
            await ReloadAsync();
            await NavBadges.RequestRefreshAsync();
        }
        else
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to save changes.", Severity.Error);
        }
    }

    // The dialog's "WFH" option has no matching API enum value, so it persists
    // as Present (the dialog UI itself should drop WFH once the API gains it).
    private static AttendanceStatus ParseAttendanceStatus(string s) => s switch
    {
        "Present" => AttendanceStatus.Present,
        "Absent"  => AttendanceStatus.Absent,
        "Late"    => AttendanceStatus.Late,
        "Leave"   => AttendanceStatus.OnLeave,
        "WFH"     => AttendanceStatus.Present,
        _         => AttendanceStatus.Present,
    };

    private static TimeOnly? ParseTime(string hhmm)
    {
        if (string.IsNullOrWhiteSpace(hhmm)) return null;
        return TimeOnly.TryParse(hhmm, out var t) ? t : null;
    }

    private async Task OpenAnalyticsDialog()
    {
        var parameters = new DialogParameters { ["Employees"] = Employees };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<AttendanceAnalyticsDialog>("Attendance Analytics", parameters, options);
    }

    private async Task OpenManualEntryDialog()
    {
        // Picker must be keyed by real Employee.Id (not by today's
        // attendance-row id), so the EmployeeId returned by the dialog matches
        // a valid employee in the manual-entry API call. Also lets HR back-fill
        // for an employee who hasn't clocked in today.
        var empRes = await EmployeesApi.ListAsync(page: 1, pageSize: 500);
        if (!empRes.Success || empRes.Value is null || empRes.Value.Items.Count == 0)
        {
            Snackbar.Add(empRes.ErrorMessage ?? "No employees yet. Add an employee first.", Severity.Warning);
            return;
        }

        var candidates = empRes.Value.Items.Select(e => new AttendanceEmployee
        {
            Id   = e.Id.ToString(),
            Name = $"{e.FirstName} {e.LastName}".Trim(),
            Dept = e.DepartmentName ?? "",
            Role = e.JobTitle ?? "",
            Init = MakeInitials($"{e.FirstName} {e.LastName}"),
            Av   = AvatarTone(e.Id),
        }).ToList();

        var parameters = new DialogParameters { ["Candidates"] = candidates };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ClockInDialog>("Manual Attendance Entry", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not ClockInResult res) return;

        if (!Guid.TryParse(res.EmployeeId, out var empId))
        {
            Snackbar.Add("Invalid employee selection.", Severity.Error);
            return;
        }

        var req = new ManualAttendanceEntryRequest(
            EmployeeId:   empId,
            Date:         DateOnly.FromDateTime(DateTime.Now),
            Status:       ParseAttendanceStatus(res.Status),
            ClockInTime:  ParseTime(res.Time),
            ClockOutTime: null,
            Notes:        $"Manual entry by HR ({res.Status})");

        var apiResult = await AttendanceApi.CreateManualAsync(req);
        if (apiResult.Success)
        {
            Snackbar.Add("Entry added.", Severity.Success);
            await ReloadAsync();
            await NavBadges.RequestRefreshAsync();
        }
        else
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to create entry.", Severity.Error);
        }
    }

    private async Task OpenOvertimeDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<OvertimeRequestsDialog>("Overtime Requests", new DialogParameters(), options);
    }

    private async Task ExportCsv()
    {
        var rows = FilteredEmployees.ToList();
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Employee,Department,Status,Time In,Time Out,Hours");
        foreach (var e in rows)
        {
            var hw = HoursWorked(e.Tin, e.Tout);
            sb.AppendLine(string.Join(",", new[] { e.Name, e.Dept, e.Status, FmtTime(e.Tin), FmtTime(e.Tout), FmtHours(hw) }));
        }
        var filename = $"attendance_{DateTime.Now:yyyy-MM-dd}.csv";
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(sb.ToString()));
        await JS.InvokeVoidAsync("eval",
            $@"(function(){{var bin=atob('{base64}');var bytes=new Uint8Array(bin.length);for(var i=0;i<bin.length;i++)bytes[i]=bin.charCodeAt(i);var blob=new Blob([bytes],{{type:'text/csv'}});var url=URL.createObjectURL(blob);var a=document.createElement('a');a.href=url;a.download='{filename}';document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(url);}})();");
        Snackbar.Add($"Exported {rows.Count} records to CSV", Severity.Success);
    }
}
