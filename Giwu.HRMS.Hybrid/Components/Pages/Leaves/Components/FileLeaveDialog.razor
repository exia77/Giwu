@using static Giwu.HRMS.Hybrid.Components.Pages.Leaves.LeaveFormatting

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (CurrentEmployee is not null)
            {
                <div class="filing-as">
                    <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" Class="giwu-text-muted" />
                    <span class="filing-as-label">Filing as</span>
                    <span class="filing-as-name">@CurrentEmployee.Name</span>
                    <span class="filing-as-dept">· @CurrentEmployee.Dept</span>
                </div>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    Your account isn't linked to an employee record, so you can't file leave for yourself.
                    Contact HR if this is unexpected.
                </MudAlert>
            }

            <MudSelect T="string" Label="Leave type" @bind-Value="SelectedLeaveTypeId"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                @foreach (var lt in AvailableLeaveTypes)
                {
                    <MudSelectItem Value="@lt.Id">
                        @lt.Name
                        @if (lt.IsMandated)
                        {
                            <span> ·</span>
                            <span style="opacity:.55;font-size:11.5px"> @lt.LegalReference</span>
                        }
                    </MudSelectItem>
                }
            </MudSelect>

            @* Raw HTML date inputs — neither MudDatePicker nor MudTextField+InputType.Date
               opens a picker reliably inside WebView2. A plain <input type="date">
               uses the WebView's native chrome and works every time. *@
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                <div class="fl-date">
                    <label class="fl-date-label">Start date</label>
                    <input type="date" class="fl-date-input"
                           value="@StartDateStr"
                           @onchange="@(e => OnStartDateChanged(e.Value?.ToString() ?? ""))" />
                </div>
                <div class="fl-date">
                    <label class="fl-date-label">End date</label>
                    <input type="date" class="fl-date-input"
                           value="@EndDateStr"
                           @onchange="@(e => OnEndDateChanged(e.Value?.ToString() ?? ""))" />
                </div>
            </div>

            @if (StartDate.HasValue && EndDate.HasValue && StartDate.Value.Date == EndDate.Value.Date)
            {
                <MudGrid Spacing="2" Class="ml-1">
                    <MudItem xs="6">
                        <MudCheckBox T="bool" @bind-Value="IsHalfDay" Size="Size.Small" Dense="true">
                            <MudText Typo="Typo.body2">Half day only</MudText>
                        </MudCheckBox>
                    </MudItem>
                    @if (IsHalfDay)
                    {
                        <MudItem xs="6">
                            <MudSelect T="string" Label="Session" @bind-Value="HalfDaySession" Dense="true"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@("AM")">AM (morning)</MudSelectItem>
                                <MudSelectItem Value="@("PM")">PM (afternoon)</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    }
                </MudGrid>
            }

            <MudTextField T="string" Label="Reason / details" @bind-Value="Reason"
                          Placeholder="e.g. Family vacation in Baguio"
                          Variant="Variant.Outlined" Lines="3" />

            @if (SelectedLeaveType?.RequiresMedCert == true && DaysRequested > SelectedLeaveType.RequiresMedCertAfterDays)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="med-cert-alert">
                    <MudIcon Icon="@Icons.Material.Outlined.MedicalServices" Size="Size.Small" Style="margin-right:4px" />
                    Medical certificate required for absences over @SelectedLeaveType.RequiresMedCertAfterDays days.
                </MudAlert>
            }

            @* Live preview *@
            @if (StartDate.HasValue && EndDate.HasValue && SelectedLeaveType != null)
            {
                <div class="file-preview">
                    <div class="file-preview-title">Request Summary</div>
                    <div class="file-preview-row">
                        <span class="file-preview-key">Period</span>
                        <span>@FmtDateRange(StartDate.Value, EndDate.Value)</span>
                    </div>
                    <div class="file-preview-row">
                        <span class="file-preview-key">Working days</span>
                        <span class="num">@FmtDays(DaysRequested)</span>
                    </div>

                    @if (CurrentBalance != null)
                    {
                        var available = CurrentBalance.Available;
                        var afterRequest = available - DaysRequested;
                        var insufficientBalance = afterRequest < 0;

                        <div class="file-preview-row">
                            <span class="file-preview-key">Current balance</span>
                            <span class="num">@available.ToString("F1") days</span>
                        </div>
                        <div class="file-preview-row file-preview-row-result">
                            <span class="file-preview-key">After this request</span>
                            <span class="num @(insufficientBalance ? "text-danger" : "")">
                                @afterRequest.ToString("F1") days
                            </span>
                        </div>
                        @if (insufficientBalance)
                        {
                            <div class="file-preview-warning">
                                <MudIcon Icon="@Icons.Material.Outlined.Warning" Size="Size.Small" />
                                <span>Insufficient balance — request exceeds available days.</span>
                            </div>
                        }
                    }
                    else if (SelectedLeaveType?.AccrualMode == LeaveAccrualMode.PerEvent)
                    {
                        <div class="file-preview-row" style="opacity:.7;font-size:11.5px">
                            <span>This leave type is granted per qualifying event. Eligibility determined at approval time.</span>
                            <span></span>
                        </div>
                    }
                    else if (SelectedLeaveType?.AccrualMode == LeaveAccrualMode.Yearly)
                    {
                        <div class="file-preview-row file-preview-row-result">
                            <span class="file-preview-key">Annual entitlement</span>
                            <span class="num">@SelectedLeaveType.AnnualEntitlementDays days/yr</span>
                        </div>
                    }
                </div>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DisableElevation="true"
                   OnClick="Submit" Disabled="@(!CanSubmit)">
            File Request
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .filing-as {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        background: var(--mud-palette-background-grey);
        border-radius: 6px;
        font-size: 13px;
    }

    /* Native date inputs styled to look like MudBlazor's outlined fields. */
    .fl-date { display: flex; flex-direction: column; gap: 4px; }
    .fl-date-label {
        font-size: 11.5px;
        color: var(--mud-palette-text-secondary);
        letter-spacing: .02em;
        padding-left: 2px;
    }
    .fl-date-input {
        appearance: none;
        -webkit-appearance: none;
        font: inherit;
        font-size: 13px;
        height: 36px;
        padding: 0 10px;
        border: 1px solid var(--mud-palette-lines-inputs);
        border-radius: 4px;
        background: var(--mud-palette-surface);
        color: var(--mud-palette-text-primary);
        outline: none;
        cursor: pointer;
    }
    .fl-date-input:focus { border-color: var(--mud-palette-primary); }
    .fl-date-input::-webkit-calendar-picker-indicator {
        cursor: pointer;
        opacity: .7;
    }
    .fl-date-input::-webkit-calendar-picker-indicator:hover { opacity: 1; }
    .filing-as-label { opacity: .6; }
    .filing-as-name { font-weight: 500; }
    .filing-as-dept { opacity: .55; font-size: 12px; }

    .med-cert-alert { font-size: 12px !important; padding: 6px 10px !important; }

    .file-preview {
        background: var(--mud-palette-background-grey);
        border-radius: 8px;
        padding: 12px;
    }
    .file-preview-title {
        font-size: 10.5px;
        letter-spacing: .06em;
        text-transform: uppercase;
        opacity: .55;
        margin-bottom: 8px;
    }
    .file-preview-row {
        display: flex;
        justify-content: space-between;
        padding: 4px 0;
        font-size: 13px;
    }
    .file-preview-row-result {
        border-top: 1px solid var(--mud-palette-divider);
        padding-top: 8px;
        margin-top: 4px;
        font-weight: 500;
    }
    .file-preview-key { opacity: .6; }
    .file-preview .num { font-variant-numeric: tabular-nums; }
    .file-preview .text-danger { color: var(--leave-red-text); }

    .file-preview-warning {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
        padding: 8px 10px;
        background: var(--leave-red-light);
        color: var(--leave-red-text);
        border-radius: 6px;
        font-size: 12px;
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The employee filing the leave (always the signed-in user).
    /// The dropdown was removed because the API derives EmployeeId from the JWT
    /// — picking someone else here was always misleading.</summary>
    [Parameter] public EmployeeLeaveView? CurrentEmployee { get; set; }
    [Parameter] public List<LeaveType> AllLeaveTypes { get; set; } = new();

    private string SelectedLeaveTypeId { get; set; } = "";
    private DateTime? StartDate { get; set; }
    private DateTime? EndDate { get; set; }
    private bool IsHalfDay { get; set; } = false;
    private string HalfDaySession { get; set; } = "AM";
    private string Reason { get; set; } = "";

    // The native <input type=date> wants ISO yyyy-MM-dd strings. These two
    // shims keep the existing DateTime? state untouched.
    private string StartDateStr => StartDate?.ToString("yyyy-MM-dd") ?? "";
    private string EndDateStr   => EndDate?.ToString("yyyy-MM-dd")   ?? "";

    private void OnStartDateChanged(string raw)
    {
        StartDate = DateTime.TryParse(raw, out var d) ? d.Date : null;
        // If end is now before start, snap it forward so the form stays consistent.
        if (StartDate is not null && (EndDate is null || EndDate < StartDate))
            EndDate = StartDate;
    }

    private void OnEndDateChanged(string raw)
    {
        EndDate = DateTime.TryParse(raw, out var d) ? d.Date : null;
    }

    private LeaveType? SelectedLeaveType =>
        AllLeaveTypes.FirstOrDefault(l => l.Id == SelectedLeaveTypeId);

    /// <summary>
    /// Filters leave types based on employee gender — Maternity/Magna/VAWC only show for female,
    /// Paternity only for male. This matches PH-mandated eligibility.
    /// </summary>
    private List<LeaveType> AvailableLeaveTypes
    {
        get
        {
            if (CurrentEmployee == null) return AllLeaveTypes;
            return AllLeaveTypes.Where(lt =>
            {
                return lt.Category switch
                {
                    LeaveCategory.Maternity => CurrentEmployee.Gender == "F",
                    LeaveCategory.Magna     => CurrentEmployee.Gender == "F",
                    LeaveCategory.Vawc      => CurrentEmployee.Gender == "F",
                    LeaveCategory.Paternity => CurrentEmployee.Gender == "M",
                    LeaveCategory.Sil       => CurrentEmployee.HireDate <= DateTime.Today.AddYears(-1),
                    _ => true
                };
            }).ToList();
        }
    }

    private LeaveBalance? CurrentBalance =>
        CurrentEmployee?.Balances.FirstOrDefault(b => b.LeaveTypeId == SelectedLeaveTypeId);

    private decimal DaysRequested
    {
        get
        {
            if (!StartDate.HasValue || !EndDate.HasValue) return 0m;
            return WorkingDays(StartDate.Value, EndDate.Value, IsHalfDay && StartDate.Value.Date == EndDate.Value.Date);
        }
    }

    private bool CanSubmit =>
        CurrentEmployee is not null
        && !string.IsNullOrEmpty(SelectedLeaveTypeId)
        && StartDate.HasValue
        && EndDate.HasValue
        && EndDate.Value >= StartDate.Value
        && DaysRequested > 0;

    protected override void OnInitialized()
    {
        StartDate = DateTime.Today.AddDays(7);
        EndDate = DateTime.Today.AddDays(7);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (!CanSubmit) return;
        var emp = CurrentEmployee!;
        var lt = SelectedLeaveType!;
        var req = new LeaveRequest
        {
            EmployeeId = emp.EmployeeId,
            EmployeeName = emp.Name,
            EmployeeInit = emp.Init,
            EmployeeAv = emp.Av,
            Dept = emp.Dept,
            LeaveTypeId = lt.Id,
            LeaveTypeName = lt.Name,
            LeaveTypeCode = lt.Code,
            LeaveCategory = lt.Category,
            StartDate = StartDate!.Value,
            EndDate = EndDate!.Value,
            IsHalfDay = IsHalfDay && StartDate.Value.Date == EndDate.Value.Date,
            HalfDaySession = IsHalfDay ? HalfDaySession : "",
            DaysRequested = DaysRequested,
            Reason = Reason,
            Status = LeaveRequestStatus.Pending,
        };
        MudDialog.Close(DialogResult.Ok(req));
    }
}
