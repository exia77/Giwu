</style>

@code {
    // ─── State ──────────────────────────────────────────────────
    private int ActiveTab { get; set; } = 0;
    private DateTime CalendarMonth { get; set; } = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    private string RequestStatusFilter { get; set; } = "All";
    private string RequestTypeFilter { get; set; } = "";
    private string RequestSearch { get; set; } = "";
    private int RequestPage { get; set; } = 0;
    private int RequestPageSize { get; set; } = 10;

    private string BalanceFilter { get; set; } = "All";
    private string BalanceSearch { get; set; } = "";
    private int BalancePage { get; set; } = 0;
    private int BalancePageSize { get; set; } = 10;

    // ─── Derived ────────────────────────────────────────────────
    private int PendingCount => Requests.Count(r => r.Status == LeaveRequestStatus.Pending);

    private int OnLeaveTodayCount => Requests
        .Where(r => r.Status == LeaveRequestStatus.Approved || r.Status == LeaveRequestStatus.Taken)
        .Count(r => DateTime.Today >= r.StartDate.Date && DateTime.Today <= r.EndDate.Date);

    private int OnLeaveTomorrowCount => Requests
        .Where(r => r.Status == LeaveRequestStatus.Approved || r.Status == LeaveRequestStatus.Taken)
        .Count(r => DateTime.Today.AddDays(1) >= r.StartDate.Date && DateTime.Today.AddDays(1) <= r.EndDate.Date);

    private int ApprovedThisMonthCount => Requests.Count(r =>
        r.Status == LeaveRequestStatus.Approved
        && r.ResolvedOn.HasValue
        && r.ResolvedOn.Value.Year == DateTime.Today.Year
        && r.ResolvedOn.Value.Month == DateTime.Today.Month);

    private decimal TotalDaysThisMonth => Requests
        .Where(r => r.Status == LeaveRequestStatus.Approved
                 && r.ResolvedOn.HasValue
                 && r.ResolvedOn.Value.Year == DateTime.Today.Year
                 && r.ResolvedOn.Value.Month == DateTime.Today.Month)
        .Sum(r => r.DaysRequested);

    private decimal AvgVlBalance
    {
        get
        {
            var balances = Employees
                .Select(e => e.Balances.FirstOrDefault(b => b.LeaveTypeId == TypeIdByCode("VL")))
                .Where(b => b != null)
                .Select(b => b!.Available)
                .ToList();
            return balances.Count == 0 ? 0m : balances.Average();
        }
    }

    private List<LeaveRequest> PendingRequests => Requests
        .Where(r => r.Status == LeaveRequestStatus.Pending)
        .OrderByDescending(r => r.FiledOn)
        .ToList();

    private List<LeaveRequest> LeavesOnDate(DateTime date) => Requests
        .Where(r => (r.Status == LeaveRequestStatus.Approved || r.Status == LeaveRequestStatus.Taken)
                 && date.Date >= r.StartDate.Date && date.Date <= r.EndDate.Date)
        .OrderBy(r => r.EmployeeName)
        .ToList();

    private IEnumerable<LeaveRequest> FilteredRequests
    {
        get
        {
            var q = (RequestSearch ?? "").Trim().ToLower();
            return Requests.Where(r =>
                (RequestStatusFilter == "All" || StatusLabel(r.Status) == RequestStatusFilter) &&
                (string.IsNullOrEmpty(RequestTypeFilter) || r.LeaveTypeId == RequestTypeFilter) &&
                (string.IsNullOrEmpty(q)
                    || r.EmployeeName.ToLower().Contains(q)
                    || r.Dept.ToLower().Contains(q))
            ).OrderByDescending(r => r.FiledOn);
        }
    }

    private IEnumerable<EmployeeLeaveView> FilteredEmployees
    {
        get
        {
            var q = (BalanceSearch ?? "").Trim().ToLower();
            return Employees.Where(e =>
            {
                if (!string.IsNullOrEmpty(q)
                    && !e.Name.ToLower().Contains(q)
                    && !e.Dept.ToLower().Contains(q)
                    && !e.Role.ToLower().Contains(q))
                    return false;

                return BalanceFilter switch
                {
                    "Low VL" => (e.Balances.FirstOrDefault(b => b.LeaveTypeId == TypeIdByCode("VL"))?.Available ?? 0m) <= 3m,
                    "Has pending" => e.Requests.Any(r => r.Status == LeaveRequestStatus.Pending),
                    _ => true
                };
            });
        }
    }

    // ── Actions ─────────────────────────────────────────────────────────────
    private async Task ApproveRequest(string id)
    {
        var req = Requests.FirstOrDefault(r => r.Id == id);
        if (req == null || req.Status != LeaveRequestStatus.Pending) return;
        if (!Guid.TryParse(req.Id, out var guid)) { Snackbar.Add("Invalid request id", Severity.Error); return; }

        var apiResult = await LeavesApi.ApproveRequestAsync(guid, new ApproveLeaveRequest("Approved"));
        if (apiResult.Success)
        {
            Snackbar.Add($"Approved leave for {req.EmployeeName}", Severity.Success);
            await ReloadAsync();
        }
        else
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to approve.", Severity.Error);
        }
    }

    private async Task OpenRejectDialog(string id)
    {
        var req = Requests.FirstOrDefault(r => r.Id == id);
        if (req == null || req.Status != LeaveRequestStatus.Pending) return;
        if (!Guid.TryParse(req.Id, out var guid)) { Snackbar.Add("Invalid request id", Severity.Error); return; }

        var parameters = new DialogParameters { ["Request"] = req };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RejectLeaveDialog>($"Reject — {req.EmployeeName}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is string reason)
        {
            var apiResult = await LeavesApi.RejectRequestAsync(guid, new RejectLeaveRequest(reason));
            if (apiResult.Success)
            {
                Snackbar.Add($"Rejected leave for {req.EmployeeName}", Severity.Warning);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to reject.", Severity.Error);
            }
        }
    }

    private async Task OpenRequestDetail(string id)
    {
        var req = Requests.FirstOrDefault(r => r.Id == id);
        if (req == null) return;
        var parameters = new DialogParameters
        {
            ["Request"] = req,
            ["OnApprove"] = EventCallback.Factory.Create<string>(this, ApproveRequest),
            ["OnReject"] = EventCallback.Factory.Create<string>(this, async rid => await OpenRejectDialog(rid)),
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<LeaveRequestDetailDialog>("Leave Request", parameters, options);
    }

    private async Task OpenFileLeaveDialog()
    {
        var parameters = new DialogParameters
        {
            ["AllEmployees"] = Employees,
            ["AllLeaveTypes"] = LeaveTypes.Where(l => l.IsActive).ToList(),
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<FileLeaveDialog>("File Leave Request", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is LeaveRequest req)
        {
            if (!Guid.TryParse(req.LeaveTypeId, out var typeGuid))
            {
                Snackbar.Add("Invalid leave type", Severity.Error);
                return;
            }

            var apiReq = new FileLeaveRequest(
                LeaveTypeId: typeGuid,
                StartDate:   DateOnly.FromDateTime(req.StartDate),
                EndDate:     DateOnly.FromDateTime(req.EndDate),
                IsHalfDay:   req.IsHalfDay,
                HalfDaySession: req.HalfDaySession,
                Reason:      req.Reason);

            var apiResult = await LeavesApi.FileRequestAsync(apiReq);
            if (apiResult.Success)
            {
                Snackbar.Add($"Filed {req.LeaveTypeCode} for {req.EmployeeName}", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to file leave.", Severity.Error);
            }
        }
    }

    private async Task OpenEmployeeLeaveDialog(string employeeId)
    {
        var emp = Employees.FirstOrDefault(e => e.EmployeeId == employeeId);
        if (emp == null) return;
        var parameters = new DialogParameters
        {
            ["Employee"] = emp,
            ["AllLeaveTypes"] = LeaveTypes,
            ["OnApprove"] = EventCallback.Factory.Create<string>(this, ApproveRequest),
            ["OnReject"] = EventCallback.Factory.Create<string>(this, async rid => await OpenRejectDialog(rid)),
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<EmployeeLeaveDialog>($"{emp.Name} — Leave", parameters, options);
    }

    private async Task OpenAddLeaveTypeDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditLeaveTypeDialog>("Add Leave Type", new DialogParameters(), options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is LeaveType lt)
        {
            var req = new CreateLeaveTypeRequest(
                Name: lt.Name, Code: lt.Code,
                Category: (Giwu.Domain.Leaves.LeaveCategory)(int)lt.Category,
                Description: lt.Description,
                IsPaid: lt.IsPaid, IsMandated: lt.IsMandated,
                AnnualEntitlementDays: lt.AnnualEntitlementDays,
                AccrualMode: (Giwu.Domain.Leaves.LeaveAccrualMode)(int)lt.AccrualMode,
                CarryoverAllowed: lt.CarryoverAllowed,
                MaxCarryoverDays: lt.MaxCarryoverDays,
                RequiresMedCert: lt.RequiresMedCert,
                RequiresMedCertAfterDays: lt.RequiresMedCertAfterDays,
                LegalReference: lt.LegalReference);

            var apiResult = await LeavesApi.CreateTypeAsync(req);
            if (apiResult.Success)
            {
                Snackbar.Add($"Added: {lt.Name}", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to add leave type.", Severity.Error);
            }
        }
    }

    private async Task CancelRequest(string id)
    {
        var req = Requests.FirstOrDefault(r => r.Id == id);
        if (req == null || req.Status != LeaveRequestStatus.Pending) return;
        if (!Guid.TryParse(req.Id, out var guid)) { Snackbar.Add("Invalid request id", Severity.Error); return; }

        var apiResult = await LeavesApi.CancelRequestAsync(guid);
        if (apiResult.Success)
        {
            Snackbar.Add($"Cancelled leave for {req.EmployeeName}", Severity.Info);
            await ReloadAsync();
        }
        else
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to cancel.", Severity.Error);
        }
    }

    private async Task DeleteLeaveType(string id)
    {
        var lt = LeaveTypes.FirstOrDefault(l => l.Id == id);
        if (lt == null) return;
        if (!Guid.TryParse(lt.Id, out var guid)) { Snackbar.Add("Invalid leave type id", Severity.Error); return; }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Delete leave type \"{lt.Name}\"?\n\nIt will be deactivated. Existing requests are unaffected.");
        if (!confirmed) return;

        var apiResult = await LeavesApi.DeleteTypeAsync(guid);
        if (apiResult.Success)
        {
            Snackbar.Add($"Deleted: {lt.Name}", Severity.Warning);
            await ReloadAsync();
        }
        else
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to delete leave type.", Severity.Error);
        }
    }

    private async Task OpenEditLeaveTypeDialog(string id)
    {
        var lt = LeaveTypes.FirstOrDefault(l => l.Id == id);
        if (lt == null) return;
        if (!Guid.TryParse(lt.Id, out var guid)) { Snackbar.Add("Invalid leave type id", Severity.Error); return; }

        var parameters = new DialogParameters { ["Existing"] = lt };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditLeaveTypeDialog>($"Edit — {lt.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is LeaveType edited)
        {
            var req = new UpdateLeaveTypeRequest(
                Name: edited.Name, Code: edited.Code,
                Category: (Giwu.Domain.Leaves.LeaveCategory)(int)edited.Category,
                Description: edited.Description,
                IsActive: edited.IsActive,
                IsPaid: edited.IsPaid, IsMandated: edited.IsMandated,
                AnnualEntitlementDays: edited.AnnualEntitlementDays,
                AccrualMode: (Giwu.Domain.Leaves.LeaveAccrualMode)(int)edited.AccrualMode,
                CarryoverAllowed: edited.CarryoverAllowed,
                MaxCarryoverDays: edited.MaxCarryoverDays,
                RequiresMedCert: edited.RequiresMedCert,
                RequiresMedCertAfterDays: edited.RequiresMedCertAfterDays,
                LegalReference: edited.LegalReference);

            var apiResult = await LeavesApi.UpdateTypeAsync(guid, req);
            if (apiResult.Success)
            {
                Snackbar.Add($"Updated: {lt.Name}", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to update leave type.", Severity.Error);
            }
        }
    }

    // ── Data (loaded from API) ──────────────────────────────────────────────
    private List<LeaveType> LeaveTypes { get; set; } = new();
    private List<EmployeeLeaveView> Employees { get; set; } = new();
    private List<LeaveRequest> Requests { get; set; } = new();

    private string? _loadError;

    private string TypeIdByCode(string code) =>
        LeaveTypes.FirstOrDefault(t => string.Equals(t.Code, code, StringComparison.OrdinalIgnoreCase))?.Id ?? "";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loadError = null;
        StateHasChanged();

        var typesTask     = LeavesApi.ListTypesAsync(includeInactive: true);
        var requestsTask  = LeavesApi.ListRequestsAsync(page: 1, pageSize: 200);
        var employeesTask = EmployeesApi.ListAsync(page: 1, pageSize: 200);
        var balancesTask  = LeavesApi.ListBalancesAsync();

        await Task.WhenAll(typesTask, requestsTask, employeesTask, balancesTask);

        if (!typesTask.Result.Success || typesTask.Result.Value is null)
        { _loadError = typesTask.Result.ErrorMessage ?? "Failed to load leave types"; return; }
        if (!requestsTask.Result.Success || requestsTask.Result.Value is null)
        { _loadError = requestsTask.Result.ErrorMessage ?? "Failed to load leave requests"; return; }
        if (!employeesTask.Result.Success || employeesTask.Result.Value is null)
        { _loadError = employeesTask.Result.ErrorMessage ?? "Failed to load employees"; return; }

        LeaveTypes = typesTask.Result.Value.Select(MapType).ToList();

        var balancesByEmp = (balancesTask.Result.Value ?? Array.Empty<LeaveBalanceDto>())
            .GroupBy(b => b.EmployeeId)
            .ToDictionary(g => g.Key, g => g.ToList());

        Requests = requestsTask.Result.Value.Items.Select(MapRequest).ToList();

        var requestsByEmp = Requests.GroupBy(r => r.EmployeeId).ToDictionary(g => g.Key, g => g.ToList());

        Employees = employeesTask.Result.Value.Items.Select(e =>
        {
            var view = new EmployeeLeaveView
            {
                EmployeeId = e.Id.ToString(),
                Name = $"{e.FirstName} {e.LastName}".Trim(),
                Init = MakeInitials(e.FirstName, e.LastName),
                Av = AvatarTone(e.Id),
                Role = e.JobTitle,
                Dept = e.DepartmentName,
                Gender = "",
                HireDate = e.HireDate.ToDateTime(TimeOnly.MinValue),
            };
            if (balancesByEmp.TryGetValue(e.Id, out var bs))
            {
                foreach (var b in bs)
                    view.Balances.Add(new LeaveBalance
                    {
                        EmployeeId = view.EmployeeId,
                        LeaveTypeId = b.LeaveTypeId.ToString(),
                        Entitlement = b.Entitlement,
                        CarryOver = b.CarryOver,
                        Used = b.Used,
                        Pending = b.Pending,
                    });
            }
            if (requestsByEmp.TryGetValue(view.EmployeeId, out var reqs))
                view.Requests.AddRange(reqs);
            return view;
        }).ToList();
    }

    private static LeaveType MapType(LeaveTypeDto dto) => new()
    {
        Id = dto.Id.ToString(),
        Name = dto.Name,
        Code = dto.Code,
        Category = (LeaveCategory)(int)dto.Category,
        Description = dto.Description,
        IsActive = dto.IsActive,
        IsPaid = dto.IsPaid,
        IsMandated = dto.IsMandated,
        AnnualEntitlementDays = dto.AnnualEntitlementDays,
        AccrualMode = (LeaveAccrualMode)(int)dto.AccrualMode,
        CarryoverAllowed = dto.CarryoverAllowed,
        MaxCarryoverDays = dto.MaxCarryoverDays,
        RequiresMedCert = dto.RequiresMedCert,
        RequiresMedCertAfterDays = dto.RequiresMedCertAfterDays,
        LegalReference = dto.LegalReference,
    };

    private static LeaveRequest MapRequest(LeaveRequestDto dto) => new()
    {
        Id = dto.Id.ToString(),
        EmployeeId = dto.EmployeeId.ToString(),
        EmployeeName = dto.EmployeeName,
        EmployeeInit = MakeInitialsFromFullName(dto.EmployeeName),
        EmployeeAv = AvatarTone(dto.EmployeeId),
        Dept = "",
        LeaveTypeId = dto.LeaveTypeId.ToString(),
        LeaveTypeName = dto.LeaveTypeName,
        LeaveTypeCode = dto.LeaveTypeCode,
        LeaveCategory = LeaveCategory.Other,
        StartDate = dto.StartDate.ToDateTime(TimeOnly.MinValue),
        EndDate = dto.EndDate.ToDateTime(TimeOnly.MinValue),
        IsHalfDay = dto.IsHalfDay,
        DaysRequested = dto.DaysRequested,
        Reason = dto.Reason,
        FiledOn = dto.FiledAt.LocalDateTime,
        Status = (LeaveRequestStatus)(int)dto.Status,
    };

    private static string MakeInitials(string first, string last)
    {
        var f = string.IsNullOrEmpty(first) ? "" : first.Substring(0, 1);
        var l = string.IsNullOrEmpty(last)  ? "" : last.Substring(0, 1);
        return (f + l).ToUpperInvariant();
    }

    private static string MakeInitialsFromFullName(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "·";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "·",
            1 => parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant(),
        };
    }

    private static readonly string[] _avTones = { "green", "blue", "amber", "purple", "primary", "red" };
    private static string AvatarTone(Guid id) => _avTones[Math.Abs(id.GetHashCode()) % _avTones.Length];

