@page "/leave"
@using static Giwu.HRMS.Hybrid.Components.Pages.Leaves.LeaveFormatting
@using Giwu.Contracts.Leaves
@using Giwu.HRMS.Hybrid.Services.Leaves
@using Giwu.HRMS.Hybrid.Services.Employees
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ILeavesApi LeavesApi
@inject IEmployeesApi EmployeesApi

@using Pages.Leaves.Components

<RoleGuard NavKey="@NavKeys.Leave" />

<PageTitle>Leave &amp; Time Off</PageTitle>

@* ═══════════════════════════════════════════════════
   KPI STRIP
═══════════════════════════════════════════════════ *@
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="leave-kpi" Elevation="0">
            <div class="kpi-label">Pending Requests</div>
            <div class="kpi-value">@PendingCount</div>
            <div class="kpi-sub">
                <span class="kpi-dot" style="background:var(--leave-amber)"></span>
                <span>need approval</span>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="leave-kpi" Elevation="0">
            <div class="kpi-label">On Leave Today</div>
            <div class="kpi-value">@OnLeaveTodayCount</div>
            <div class="kpi-sub">
                <span class="kpi-dot" style="background:var(--leave-blue)"></span>
                <span>@OnLeaveTomorrowCount tomorrow</span>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="leave-kpi" Elevation="0">
            <div class="kpi-label">Approved This Month</div>
            <div class="kpi-value">@ApprovedThisMonthCount</div>
            <div class="kpi-sub">
                <span class="kpi-dot" style="background:var(--leave-green)"></span>
                <span>@TotalDaysThisMonth.ToString("F0") days total</span>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="leave-kpi" Elevation="0">
            <div class="kpi-label">Avg VL Balance</div>
            <div class="kpi-value">@AvgVlBalance.ToString("F1")</div>
            <div class="kpi-sub">
                <span class="kpi-dot" style="background:var(--leave-purple)"></span>
                <span>days available per employee</span>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@* ═══════════════════════════════════════════════════
   MIDDLE ROW: TEAM CALENDAR + PENDING QUEUE
═══════════════════════════════════════════════════ *@
<MudGrid Spacing="3" Class="mb-4">
    @* ── Team calendar ── *@
    <MudItem xs="12" md="8">
        <MudPaper Class="leave-card" Elevation="0">
            <div class="leave-card-header">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="fw-medium">@CalendarMonth.ToString("MMMM yyyy")</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.55">Team availability</MudText>
                </div>
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Small"
                                   OnClick="@(() => CalendarMonth = CalendarMonth.AddMonths(-1))" />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               OnClick="@(() => CalendarMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))">
                        Today
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small"
                                   OnClick="@(() => CalendarMonth = CalendarMonth.AddMonths(1))" />
                </MudStack>
            </div>

            @* Calendar grid *@
            <div class="cal-grid">
                <div class="cal-weekday-row">
                    <div class="cal-weekday">Sun</div>
                    <div class="cal-weekday">Mon</div>
                    <div class="cal-weekday">Tue</div>
                    <div class="cal-weekday">Wed</div>
                    <div class="cal-weekday">Thu</div>
                    <div class="cal-weekday">Fri</div>
                    <div class="cal-weekday">Sat</div>
                </div>
                <div class="cal-days">
                    @{
                        var firstOfMonth = new DateTime(CalendarMonth.Year, CalendarMonth.Month, 1);
                        var leadingBlanks = (int)firstOfMonth.DayOfWeek; // Sunday=0
                        var daysInMonth = DateTime.DaysInMonth(CalendarMonth.Year, CalendarMonth.Month);
                    }
                    @for (int i = 0; i < leadingBlanks; i++)
                    {
                        <div class="cal-day cal-day-blank"></div>
                    }
                    @for (int day = 1; day <= daysInMonth; day++)
                    {
                        var thisDate = new DateTime(CalendarMonth.Year, CalendarMonth.Month, day);
                        var leaveOnDay = LeavesOnDate(thisDate);
                        var isWeekend = thisDate.DayOfWeek == DayOfWeek.Saturday || thisDate.DayOfWeek == DayOfWeek.Sunday;
                        var isToday = thisDate.Date == DateTime.Today;
                        <div class="cal-day @(isWeekend ? "cal-day-weekend" : "") @(isToday ? "cal-day-today" : "")"
                             title="@($"{thisDate:dddd, MMM d, yyyy}{(leaveOnDay.Count > 0 ? $" — {leaveOnDay.Count} on leave" : "")}")">
                            <div class="cal-day-num">@day</div>
                            @if (leaveOnDay.Count > 0)
                            {
                                <div class="cal-day-leaves">
                                    @foreach (var req in leaveOnDay.Take(3))
                                    {
                                        <div class="cal-leave-pill"
                                             style="@($"background:{CategoryDotColor(req.LeaveCategory)}")"
                                             title="@($"{req.EmployeeName} · {req.LeaveTypeCode}")">
                                            @req.EmployeeInit
                                        </div>
                                    }
                                    @if (leaveOnDay.Count > 3)
                                    {
                                        <div class="cal-leave-more">+@(leaveOnDay.Count - 3)</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Legend *@
            <div class="cal-legend">
                <div class="cal-legend-item"><span class="cal-legend-dot" style="background:var(--leave-blue)"></span>VL</div>
                <div class="cal-legend-item"><span class="cal-legend-dot" style="background:var(--leave-red)"></span>SL</div>
                <div class="cal-legend-item"><span class="cal-legend-dot" style="background:var(--leave-amber)"></span>EL</div>
                <div class="cal-legend-item"><span class="cal-legend-dot" style="background:var(--leave-pink)"></span>ML / Magna</div>
                <div class="cal-legend-item"><span class="cal-legend-dot" style="background:var(--leave-teal)"></span>PL</div>
                <div class="cal-legend-item"><span class="cal-legend-dot" style="background:var(--leave-purple)"></span>Solo</div>
                <div class="cal-legend-item"><span class="cal-legend-dot" style="background:var(--leave-green)"></span>SIL</div>
            </div>
        </MudPaper>
    </MudItem>

    @* ── Pending queue ── *@
    <MudItem xs="12" md="4">
        <MudPaper Class="leave-card" Elevation="0">
            <div class="leave-card-header">
                <MudText Typo="Typo.subtitle2" Class="fw-medium">Pending Approvals</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                         Style="height:20px;font-size:.7rem">@PendingCount</MudChip>
            </div>
            @if (PendingCount == 0)
            {
                <div class="leave-empty">
                    <div class="leave-empty-icon">✓</div>
                    <MudText Typo="Typo.body2">All caught up.</MudText>
                </div>
            }
            else
            {
                @foreach (var req in PendingRequests.Take(5))
                {
                    <div class="pending-row" @onclick="@(() => OpenRequestDetail(req.Id))">
                        <MudAvatar Style="@AvatarStyle(req.EmployeeAv)" Class="leave-av-sm">@req.EmployeeInit</MudAvatar>
                        <div class="pending-meta">
                            <div class="pending-name">
                                <span>@req.EmployeeName</span>
                                <span class="@($"leave-badge {CategoryBadgeClass(req.LeaveCategory)}")">@req.LeaveTypeCode</span>
                            </div>
                            <div class="pending-detail">
                                @FmtDateRange(req.StartDate, req.EndDate) · @FmtDays(req.DaysRequested)
                            </div>
                        </div>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Check" Color="Color.Success" Size="Size.Small"
                                           Title="Approve"
                                           OnClick="@(() => ApproveRequest(req.Id))" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Close" Color="Color.Error" Size="Size.Small"
                                           Title="Reject"
                                           OnClick="@(() => OpenRejectDialog(req.Id))" />
                        </MudStack>
                    </div>
                }
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@* ═══════════════════════════════════════════════════
   MAIN TABS
═══════════════════════════════════════════════════ *@
<MudPaper Class="leave-card" Elevation="0">
    <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
             PanelClass="leave-tab-panel" TabPanelClass="leave-tab-item"
             @bind-ActivePanelIndex="ActiveTab">

        @* ══ REQUESTS TAB ══ *@
        <MudTabPanel Text="@($"Requests ({Requests.Count})")"
                     Icon="@Icons.Material.Outlined.EventNote">
            <div class="leave-card-header">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="fw-medium">All Leave Requests</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.55">
                        @FilteredRequests.Count() of @Requests.Count records
                    </MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Add" DisableElevation="true"
                           OnClick="OpenFileLeaveDialog">File Leave</MudButton>
            </div>

            <div class="filter-row">
                <MudChipSet T="string" @bind-SelectedValue="RequestStatusFilter" CheckMark="false" Mandatory="true">
                    <MudChip T="string" Value="@("All")" Size="Size.Small">All</MudChip>
                    <MudChip T="string" Value="@("Pending")" Size="Size.Small">Pending</MudChip>
                    <MudChip T="string" Value="@("Approved")" Size="Size.Small">Approved</MudChip>
                    <MudChip T="string" Value="@("Rejected")" Size="Size.Small">Rejected</MudChip>
                    <MudChip T="string" Value="@("Cancelled")" Size="Size.Small">Cancelled</MudChip>
                </MudChipSet>
                <MudSpacer />
                <MudSelect T="string" @bind-Value="RequestTypeFilter" Placeholder="All types" Dense="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" Clearable="true">
                    <MudSelectItem Value="@("")">All types</MudSelectItem>
                    @foreach (var lt in LeaveTypes.Where(l => l.IsActive))
                    {
                        <MudSelectItem Value="@lt.Id">@lt.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="RequestSearch" Placeholder="Search employee…"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="leave-search"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              DebounceInterval="200" Immediate="true" />
            </div>

            <MudTable T="LeaveRequest" Items="@FilteredRequests" Dense="true" Hover="true"
                      Elevation="0" Breakpoint="Breakpoint.Sm"
                      @bind-RowsPerPage="RequestPageSize" @bind-Page="RequestPage"
                      Class="leave-mud-table">
                <HeaderContent>
                    <MudTh><MudTableSortLabel T="LeaveRequest" SortBy="@(r => r.FiledOn)">Filed</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="LeaveRequest" SortBy="@(r => r.EmployeeName)">Employee</MudTableSortLabel></MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Dates</MudTh>
                    <MudTh Style="text-align:right">Days</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Filed" Style="opacity:.7;font-size:12px">@FmtDateShort(context.FiledOn)</MudTd>
                    <MudTd DataLabel="Employee">
                        <div style="display:flex;align-items:center;gap:9px">
                            <MudAvatar Style="@AvatarStyle(context.EmployeeAv)" Class="leave-av-sm">@context.EmployeeInit</MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2" Class="fw-medium" Style="line-height:1.2">@context.EmployeeName</MudText>
                                <MudText Typo="Typo.caption" Style="opacity:.55">@context.Dept</MudText>
                            </div>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Type">
                        <span class="@($"leave-badge {CategoryBadgeClass(context.LeaveCategory)}")">
                            @context.LeaveTypeCode
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Dates" Style="font-size:12.5px">@FmtDateRange(context.StartDate, context.EndDate)</MudTd>
                    <MudTd DataLabel="Days" Style="text-align:right;font-variant-numeric:tabular-nums">
                        @context.DaysRequested.ToString(context.DaysRequested == Math.Floor(context.DaysRequested) ? "F0" : "F1")
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <span class="@($"leave-status {StatusBadgeClass(context.Status)}")">@StatusLabel(context.Status)</span>
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            @if (context.Status == LeaveRequestStatus.Pending)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                           DisableElevation="true" Style="min-width:unset"
                                           OnClick="@(() => ApproveRequest(context.Id))">Approve</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                           Style="min-width:unset"
                                           OnClick="@(() => OpenRejectDialog(context.Id))">Reject</MudButton>
                                <MudIconButton Icon="@Icons.Material.Outlined.Cancel" Size="Size.Small"
                                               Title="Cancel request"
                                               OnClick="@(() => CancelRequest(context.Id))" />
                            }
                            <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small"
                                           OnClick="@(() => OpenRequestDetail(context.Id))" />
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="leave-empty">
                        <div class="leave-empty-icon">⊘</div>
                        <MudText Typo="Typo.body2">No requests match your filter.</MudText>
                    </div>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                </PagerContent>
            </MudTable>
        </MudTabPanel>

        @* ══ BALANCES TAB ══ *@
        <MudTabPanel Text="@($"Balances ({Employees.Count})")"
                     Icon="@Icons.Material.Outlined.AccountBalance">
            <div class="leave-card-header">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="fw-medium">Leave Balances</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.55">
                        Available days per employee, by leave type
                    </MudText>
                </div>
            </div>

            <div class="filter-row">
                <MudChipSet T="string" @bind-SelectedValue="BalanceFilter" CheckMark="false" Mandatory="true">
                    <MudChip T="string" Value="@("All")" Size="Size.Small">All</MudChip>
                    <MudChip T="string" Value="@("Low VL")" Size="Size.Small">Low VL (≤3 days)</MudChip>
                    <MudChip T="string" Value="@("Has pending")" Size="Size.Small">Has pending</MudChip>
                </MudChipSet>
                <MudSpacer />
                <MudTextField @bind-Value="BalanceSearch" Placeholder="Search employee, dept…"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="leave-search"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              DebounceInterval="200" Immediate="true" />
            </div>

            <MudTable T="EmployeeLeaveView" Items="@FilteredEmployees" Dense="true" Hover="true"
                      Elevation="0" Breakpoint="Breakpoint.Sm"
                      @bind-RowsPerPage="BalancePageSize" @bind-Page="BalancePage"
                      Class="leave-mud-table">
                <HeaderContent>
                    <MudTh><MudTableSortLabel T="EmployeeLeaveView" SortBy="@(e => e.Name)">Employee</MudTableSortLabel></MudTh>
                    <MudTh>Department</MudTh>
                    <MudTh Style="text-align:right">VL</MudTh>
                    <MudTh Style="text-align:right">SL</MudTh>
                    <MudTh Style="text-align:right">EL</MudTh>
                    <MudTh Style="text-align:right">SIL</MudTh>
                    <MudTh>Pending</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Employee">
                        <div style="display:flex;align-items:center;gap:9px">
                            <MudAvatar Style="@AvatarStyle(context.Av)" Class="leave-av-sm">@context.Init</MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2" Class="fw-medium" Style="line-height:1.2">@context.Name</MudText>
                                <MudText Typo="Typo.caption" Style="opacity:.55">@context.Role</MudText>
                            </div>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Department" Style="opacity:.75">@context.Dept</MudTd>
                    <MudTd DataLabel="VL" Style="text-align:right">
                        @{
                            var balVl = context.Balances.FirstOrDefault(b => b.LeaveTypeId == TypeIdByCode("VL"));
                        }
                        @if (balVl == null)
                        {
                            <span class="bal-cell bal-zero">—</span>
                        }
                        else
                        {
                            var avail = balVl.Available;
                            var cls = avail == 0m ? "bal-cell bal-zero" : avail <= 2m ? "bal-cell bal-low" : "bal-cell";
                            <span class="@cls">
                                <span class="bal-avail">@avail.ToString(avail == Math.Floor(avail) ? "F0" : "F1")</span>
                                <span class="bal-suffix">/ @((balVl.Entitlement + balVl.CarryOver).ToString("F0"))</span>
                            </span>
                        }
                    </MudTd>
                    <MudTd DataLabel="SL" Style="text-align:right">
                        @{
                            var balSl = context.Balances.FirstOrDefault(b => b.LeaveTypeId == TypeIdByCode("SL"));
                        }
                        @if (balSl == null)
                        {
                            <span class="bal-cell bal-zero">—</span>
                        }
                        else
                        {
                            var avail = balSl.Available;
                            var cls = avail == 0m ? "bal-cell bal-zero" : avail <= 2m ? "bal-cell bal-low" : "bal-cell";
                            <span class="@cls">
                                <span class="bal-avail">@avail.ToString(avail == Math.Floor(avail) ? "F0" : "F1")</span>
                                <span class="bal-suffix">/ @((balSl.Entitlement + balSl.CarryOver).ToString("F0"))</span>
                            </span>
                        }
                    </MudTd>
                    <MudTd DataLabel="EL" Style="text-align:right">
                        @{
                            var balEl = context.Balances.FirstOrDefault(b => b.LeaveTypeId == TypeIdByCode("EL"));
                        }
                        @if (balEl == null)
                        {
                            <span class="bal-cell bal-zero">—</span>
                        }
                        else
                        {
                            var avail = balEl.Available;
                            var cls = avail == 0m ? "bal-cell bal-zero" : avail <= 2m ? "bal-cell bal-low" : "bal-cell";
                            <span class="@cls">
                                <span class="bal-avail">@avail.ToString(avail == Math.Floor(avail) ? "F0" : "F1")</span>
                                <span class="bal-suffix">/ @((balEl.Entitlement + balEl.CarryOver).ToString("F0"))</span>
                            </span>
                        }
                    </MudTd>
                    <MudTd DataLabel="SIL" Style="text-align:right">
                        @{
                            var balSil = context.Balances.FirstOrDefault(b => b.LeaveTypeId == TypeIdByCode("SIL"));
                        }
                        @if (balSil == null)
                        {
                            <span class="bal-cell bal-zero">—</span>
                        }
                        else
                        {
                            var avail = balSil.Available;
                            var cls = avail == 0m ? "bal-cell bal-zero" : avail <= 2m ? "bal-cell bal-low" : "bal-cell";
                            <span class="@cls">
                                <span class="bal-avail">@avail.ToString(avail == Math.Floor(avail) ? "F0" : "F1")</span>
                                <span class="bal-suffix">/ @((balSil.Entitlement + balSil.CarryOver).ToString("F0"))</span>
                            </span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Pending">
                        @{
                            var pending = context.Requests.Count(r => r.Status == LeaveRequestStatus.Pending);
                        }
                        @if (pending > 0)
                        {
                            <span class="leave-status leave-status-pending">@pending pending</span>
                        }
                        else
                        {
                            <span style="opacity:.4">—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   OnClick="@(() => OpenEmployeeLeaveDialog(context.EmployeeId))">View</MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="leave-empty">
                        <div class="leave-empty-icon">⊘</div>
                        <MudText Typo="Typo.body2">No employees match your filter.</MudText>
                    </div>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                </PagerContent>
            </MudTable>
        </MudTabPanel>

        @* ══ LEAVE TYPES TAB ══ *@
        <MudTabPanel Text="@($"Leave Types ({LeaveTypes.Count(l => l.IsActive)})")"
                     Icon="@Icons.Material.Outlined.Style">
            <div class="leave-card-header">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="fw-medium">Leave Type Configuration</MudText>
                    <MudText Typo="Typo.caption" Style="opacity:.55">
                        PH-mandated and company-defined leave types
                    </MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Add" DisableElevation="true"
                           OnClick="OpenAddLeaveTypeDialog">Add Type</MudButton>
            </div>

            <MudTable T="LeaveType" Items="@LeaveTypes" Dense="true" Hover="true"
                      Elevation="0" Breakpoint="Breakpoint.Sm"
                      Class="leave-mud-table">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Code</MudTh>
                    <MudTh>Entitlement</MudTh>
                    <MudTh>Accrual</MudTh>
                    <MudTh>Carryover</MudTh>
                    <MudTh>Reference</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <div style="display:flex;align-items:center;gap:6px">
                            <MudText Typo="Typo.body2" Class="fw-medium">@context.Name</MudText>
                            @if (context.IsMandated)
                            {
                                <span class="leave-mandated-chip">Mandated</span>
                            }
                            @if (!context.IsPaid)
                            {
                                <span class="leave-unpaid-chip">Unpaid</span>
                            }
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Code">
                        <span class="@($"leave-badge {CategoryBadgeClass(context.Category)}")">@context.Code</span>
                    </MudTd>
                    <MudTd DataLabel="Entitlement" Style="font-variant-numeric:tabular-nums">
                        @context.AnnualEntitlementDays days/yr
                    </MudTd>
                    <MudTd DataLabel="Accrual" Style="font-size:12.5px;opacity:.8">@AccrualModeLabel(context.AccrualMode)</MudTd>
                    <MudTd DataLabel="Carryover" Style="font-size:12.5px">
                        @if (context.CarryoverAllowed)
                        {
                            <span>up to @context.MaxCarryoverDays days</span>
                        }
                        else
                        {
                            <span style="opacity:.5">No</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Reference" Style="font-size:11.5px;opacity:.7">
                        @(string.IsNullOrEmpty(context.LegalReference) ? "—" : context.LegalReference)
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.IsActive)
                        {
                            <span class="leave-status leave-status-approved">Active</span>
                        }
                        else
                        {
                            <span class="leave-status leave-status-cancelled">Inactive</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                           OnClick="@(() => OpenEditLeaveTypeDialog(context.Id))" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                           Title="Delete leave type"
                                           OnClick="@(() => DeleteLeaveType(context.Id))" />
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="leave-empty">
                        <div class="leave-empty-icon">⊘</div>
                        <MudText Typo="Typo.body2">No leave types configured.</MudText>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</MudPaper>

